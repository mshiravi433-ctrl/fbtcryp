    "react-i18next": "^15.0.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.10.1",
    "telegraf": "^4.16.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
