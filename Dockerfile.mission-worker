# Durable Mission Control worker (Node 24 + node:sqlite). NOT for serverless.
FROM node:24-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
# The lockfile contains an optional macOS-only fsevents entry; --force keeps
# Linux installs reproducible without running package lifecycle scripts.
RUN npm ci --omit=dev --ignore-scripts --force --no-audit --no-fund
COPY server ./server
COPY src ./src
COPY scripts ./scripts
RUN mkdir -p /app/data/mission-control && chown -R node:node /app/data
USER node
EXPOSE 8788
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.MISSION_WORKER_PORT||8788)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/missionControl/worker.js"]
