# =============================================================================
# STAGE-1 LIMITED CANARY SAMPLE CONFIG — AAVE V3 · BASE (8453) · NATIVE USDC
# =============================================================================
# وضعیت پیش‌فرض مخزن: capital-off (غیرفعال).
# این فایل صرفاً نمونهٔ آمادهٔ مرحلهٔ ۱ (canary محدود فقط برای Aave Base) است.
# هیچ کلید خصوصی، عبارت بازیابی (seed/mnemonic) یا توکن محرمانه‌ای هرگز نباید
# در این فایل، محیط CI، یا داشبورد Vercel قرار بگیرد.
#
# پیش‌نیازهای تکمیل‌شده در کد:
#   ✓ شواهد strict fork روی Aave Base: PASS (50/50 در CI job 102268394490 +
#     فایل لنگر farm-fork-evidence/aave-base.json با sha256 ثبت‌شده)
#   ✓ دروازهٔ fail-closed ساخت: scripts/farm-rollout-policy.mjs
#   ✓ مسیر خروج (Withdraw / Revoke): مستقل از پرچم‌ها و همیشه باز برای hasPosition
#
# تنها ۲ مورد باقی‌مانده پیش از اجرای واقعی:
#   ۱. مجوز صریح مالک پروژه برای اجرای تراکنش زندهٔ canary
#   ۲. جایگزینی آدرس عمومی والت canary مالک در VITE_AAVE_BASE_SUPPLY_ALLOWLIST
#      (پیشنهاد موجودی والت روی Base 8453: حداقل 5 USDC بومی + 0.001 ETH گاز)
# =============================================================================

# ── ۱. دروازهٔ مرحله‌ای بیلد (فقط aave-base باز؛ ۴ پروتکل دیگر بسته) ──────────
FARM_ROLLOUT_PROTOCOLS=aave-base
FARM_STRICT_FORK_EVIDENCE=true

# تا پیش از تکمیل چرخهٔ کامل canary زنده (supply + receipt + withdraw کامل + ثبت tx hash)
# این متغیر باید false بماند تا بیلد در حالت limited-canary بماند و عمومی نشود.
FARM_CANARY_CONFIRMED=false

# ── ۲. پیکربندی انحصاری Aave v3 Base (USDC بومی 0x8335…2913) ──────────────────
VITE_ENABLE_AAVE_BASE_SUPPLY=true
# آدرس عمومی (0x + 40 کاراکتر هگز) والت مالک برای تست canary را وارد کنید
# (نمونهٔ والت دریافت کارمزد اپراتور در مخزن: 0xaf5CE154cEfd22Da5BD1D0a54479E81963A224d6)
VITE_AAVE_BASE_SUPPLY_ALLOWLIST=0xREPLACE_WITH_OWNER_PUBLIC_CANARY_WALLET
VITE_AAVE_BASE_SUPPLY_PUBLIC=false

# نکتهٔ سقف مبلغ: متغیرهای قدیمی VITE_*_MAX_* پس از PASS شواهد fork از کد حذف
# شده‌اند (قرارداد فعلی uncapped است و فقط سقف آن‌چین پروتکل Aave و موجودی والت
# کاربر ملاک است). برای canary زنده همچنان رقم پیشنهادی عملیاتی ۵ USDC است.

# ── ۳. سایر پروتکل‌ها در مرحلهٔ ۱ صراحتاً خاموش می‌مانند ──────────────────────
VITE_ENABLE_COMPOUND_BASE_SUPPLY=false
VITE_COMPOUND_BASE_SUPPLY_ALLOWLIST=
VITE_COMPOUND_BASE_SUPPLY_PUBLIC=false

VITE_ENABLE_AAVE_ARBITRUM_SUPPLY=false
VITE_AAVE_ARB_SUPPLY_ALLOWLIST=
VITE_AAVE_ARB_SUPPLY_PUBLIC=false

VITE_ENABLE_LIDO_STAKE=false
VITE_LIDO_STAKE_ALLOWLIST=
VITE_LIDO_STAKE_PUBLIC=false

VITE_ENABLE_MORPHO_BASE_SUPPLY=false
VITE_MORPHO_BASE_SUPPLY_ALLOWLIST=
VITE_MORPHO_BASE_SUPPLY_PUBLIC=false

# ── ۴. SplitRouter تا پیش از ممیزی مستقل خارجی خاموش (واریز مستقیم ۰٪ کارمزد) ─
VITE_FBT_SPLIT_ROUTER_BASE=
VITE_FBT_SPLIT_ROUTER_ARBITRUM=
VITE_FBT_SPLIT_ROUTER_ETHEREUM=
