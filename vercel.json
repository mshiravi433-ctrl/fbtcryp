{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:full",
  "outputDirectory": "dist",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "arena/*": false
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/iran-buy/return",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    { "source": "/صرافی-غیرمتمرکز", "destination": "/decentralized-crypto-exchange", "statusCode": 308 },
    { "source": "/هشدار-قیمت-ارز-دیجیتال", "destination": "/fa/crypto-price-alerts-and-dca", "statusCode": 308 },
    { "source": "/تحلیل-تکنیکال-ارز-دیجیتال", "destination": "/fa/crypto-market-history-analysis", "statusCode": 308 },
    { "source": "/کیف-پول-غیرامانی", "destination": "/fa/non-custodial-wallet", "statusCode": 308 },
    { "source": "/سواپ-ارز-دیجیتال", "destination": "/fa/crypto-swap-without-kyc", "statusCode": 308 },
    { "source": "/سرمایه-گذاری-در-ارز-دیجیتال", "destination": "/fa/crypto-investing-yield-and-lending", "statusCode": 308 },
    { "source": "/سواپ-سولانا", "destination": "/fa/solana-token-swap", "statusCode": 308 },
    { "source": "/آموزش-ارز-دیجیتال", "destination": "/fa/crypto-education", "statusCode": 308 },
    { "source": "/آموزش-توسعه-دهندگان", "destination": "/fa/developers", "statusCode": 308 },
    { "source": "/بازار-کریپتو-نمودار-سیگنال", "destination": "/fa/crypto-market-charts-signals", "statusCode": 308 },
    { "source": "/سهام-جهانی-توکنی‌شده", "destination": "/fa/tokenized-global-stocks", "statusCode": 308 },
    { "source": "/کارمزد-سواپ-ارز-دیجیتال", "destination": "/fa/how-crypto-swap-fees-work", "statusCode": 308 },
    { "source": "/تفاوت-کیف-پول-امانی-و-غیرامانی", "destination": "/fa/custodial-vs-non-custodial-wallets", "statusCode": 308 },
    { "source": "/بدون-احراز-هویت-چه-چیزی-خصوصی-می-ماند", "destination": "/fa/what-stays-private-without-kyc", "statusCode": 308 },
    { "source": "/وبلاگ", "destination": "/fa/blog", "statusCode": 308 }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.png|icon-192.png|icon-512.png|icon-maskable-192.png|icon-maskable-384.png|icon-maskable-512.png|apple-touch-icon.png|social-card.png|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/landing/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/train",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/smart-money",
      "schedule": "41 21 * * *"
    }
  ]
}
