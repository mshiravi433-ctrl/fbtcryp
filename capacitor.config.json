{
  "appId": "ir.fbtswap.app",
  "appName": "FBT Swap",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#00030F"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#00030F",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"],
      "smallIcon": "ic_stat_notification",
      "iconColor": "#00E5FF"
    }
  }
}
