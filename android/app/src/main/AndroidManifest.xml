<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <!--
          Notification presentation defaults (Android 8+ FCM channel-less
          messages and any notification the OS builds on our behalf).

          Without these, Android's fallback small icon is the LAUNCHER icon —
          a 512px neon artwork squashed to 24dp and silhouetted into a white
          blob. `ic_stat_notification` is the monochrome brand mark (a real
          vector, res/drawable/), and the colour is the brand cyan already
          defined as brand_accent — the same #00E5FF the theme, splash and
          web notification icons use, so the shade matches the app.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand_accent" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links: wallets return here after signing, e.g.
                 WalletConnect redirecting back with ir.fbtswap.app:// -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

            <!-- App Links: Solana wallets (Phantom, Solflare) return to https://fbtswap.ir/?sol=1...
                 Matching origin prevents "Redirect link origin does not match app origin" error. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="fbtswap.ir" />
                <data android:scheme="https" android:host="www.fbtswap.ir" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- ====================================================================
         Permissions

         Deliberately minimal. A crypto wallet asking for contacts, SMS,
         location or storage is a red flag to any careful user, and app stores
         require a justification for each one. We request only what the app
         genuinely uses:

           INTERNET        — market data, swap routing, AI endpoints
           ACCESS_NETWORK_STATE — detect offline so we show cached prices
                             instead of spinning forever
           USE_BIOMETRIC   — the fingerprint/face unlock in Settings
           VIBRATE         — haptic feedback on taps and confirmations
           CAMERA          — the QR scanner for reading wallet addresses
           POST_NOTIFICATIONS — price alerts and order triggers
           DETECT_SCREEN_CAPTURE — «you took a screenshot, share it?» (API 34+,
                             normal permission; the image is never read)

         NOT requested, and should stay that way:
           READ/WRITE_EXTERNAL_STORAGE — the encrypted wallet lives in app
                             storage; nothing is written to shared storage
           ACCESS_FINE_LOCATION, READ_CONTACTS, SEND_SMS — no legitimate use
         ==================================================================== -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      DETECT_SCREEN_CAPTURE — Android 14+ tells the visible activity that the
      user took a screenshot (Activity.ScreenCaptureCallback). A NORMAL,
      install-time permission: no dialog, no access to the image itself. The app
      uses the signal only to offer, for 30 seconds, «share this screen with the
      site's watermark» (src/components/ScreenshotSharePrompt.jsx).
    -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <!--
      CAMERA — for the QR scanner (src/components/QrScanner.jsx).

      The comment above used to say the camera was deliberately NOT requested
      because WalletConnect pairs by deep link. That was true when written, and
      then a QR scanner was added for reading wallet addresses without it being
      re-examined.

      The result: getUserMedia() inside the WebView is refused by the OS before
      any permission dialog can appear, because an app cannot prompt for a
      permission it never declared. The scanner opened to a black screen and no
      dialog was ever shown - which reads as "the camera is broken" rather than
      "permission denied".

      Declaring it is what makes the runtime prompt possible at all. It stays
      optional hardware below, so Play does not hide the listing from devices
      without a camera.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Android 13 (API 33) made notifications a RUNTIME permission. Without
      this declaration the OS silently drops every notification the app posts
      on 13+, which is most devices now — the feature appears to work in code
      and simply never reaches the user. Declaring it is also what lets the
      web layer's Notification.requestPermission() actually show a prompt
      inside the WebView.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Biometric hardware is optional: the app works fine without it, so
         don't let Play hide the listing from devices that lack a sensor. -->
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11+ package visibility. The WalletConnect hand-off bridge
         resolves an ACTION_VIEW intent against one exact installed wallet;
         without these package declarations resolveActivity() is deliberately
         hidden by Android even when the wallet is installed. -->
    <queries>
        <package android:name="io.metamask" />
        <package android:name="com.wallet.crypto.trustapp" />
        <package android:name="com.uniswap.mobile" />
        <package android:name="io.safepal.wallet" />
        <package android:name="me.rainbow" />
        <!-- Solana: the packages the SolanaLink bridge hands a connect/sign
             deep link to (Phantom, Solflare, Backpack). -->
        <package android:name="app.phantom" />
        <package android:name="com.solflare.mobile" />
        <package android:name="app.backpack.mobile" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

</manifest>
