<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Base application theme.

      Parent is DayNight, not Light. It was `Theme.AppCompat.Light.DarkActionBar`
      — a LIGHT theme under an app that is black everywhere. That is where the
      white flash between the launch screen and the first React paint came
      from: for those frames the window background is the theme's, and a Light
      theme's window background is white.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/ic_launcher_background</item>
        <item name="colorPrimaryDark">@color/ic_launcher_background</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>

    <!--
      The theme the Activity actually runs under (BridgeActivity swaps to it in
      onCreate). `android:background: @null` left the window with no colour of
      its own, so a WebView that has not painted yet shows through as whatever
      is underneath — white on most devices. Giving it the brand black means
      the worst case is a black frame on a black app, i.e. invisible.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/ic_launcher_background</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>

        <!--
          SYSTEM BARS (status bar = battery header, navigation bar = mobile
          buttons footer). #8C00030F is brand black at 55% alpha: the web
          content paints behind the bar (edge-to-edge, set in MainActivity)
          and the site's animated backdrop shows through, so the bar reads
          as frosted glass in the site's own colour.

          These are the DARK-THEME defaults — dark is the app's default
          theme, so the first frame never shows a wrong-coloured slab.
          MainActivity.java re-tints both bars and flips the icon colour
          (white on dark glass, black on light glass) the moment the web
          layer reports the active theme via window.FBTSystemUI.setTheme().
          On Android 15+ the OS ignores these colours and the bars are fully
          transparent — the same glass effect.
        -->
        <!--
          #AARRGGBB, not 0xAARRGGBB. An Android resource colour is parsed by
          AAPT2, which only accepts the `#` literal form; the Java/Kotlin
          `0x` prefix is a raw string to it and fails the build outright:

              values.xml:1011: error: expected color but got (raw string) 0x8C00030F
              error: failed linking references.

          This is a compile-time error, not a rendering quirk, so it took the
          whole APK down with it.
        -->
        <item name="android:statusBarColor">#8C00030F</item>
        <item name="android:navigationBarColor">#8C00030F</item>
        <!-- White clock/battery and nav buttons on the dark glass. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!--
      LAUNCH THEME.

      ─── WHY THE ANDROID 12 ATTRIBUTES ARE NOT OPTIONAL ──────────────────────
      From Android 12 the system draws its OWN splash screen on every cold
      start and IGNORES android:windowBackground when it is a drawable rather
      than a plain colour. It builds that screen from
      `windowSplashScreenBackground` + `windowSplashScreenAnimatedIcon`, and
      when neither is set it falls back to the launcher icon on a background
      taken from the theme — which, under the Light parent above, was white.

      That is the second source of the white box, and it is the one that
      affects most phones in use: nothing in the old configuration addressed
      Android 12+ at all. Setting the three attributes below is what makes the
      OS draw OUR mark on OUR black.

      The compat attributes (no `android:` prefix) come from
      androidx.core:core-splashscreen, already a dependency, and they apply the
      same look on Android 6–11 where the platform attributes do not exist.
      postSplashScreenTheme hands over to the running theme afterwards, so the
      launch drawable does not stay behind the WebView.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>

        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon</item>

        <!-- Pre-12 devices, and any surface that still reads the plain
             window background, get the same composition as a layer-list. -->
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
