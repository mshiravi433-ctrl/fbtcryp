# ═══════════════════════════════════════════════════════════════════════════
# FBT — الگوی متغیرهای محیطی
# ═══════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env
#
# هر متغیری که در کد خوانده می‌شود اینجا هست، با یک خط توضیح فارسی، مقدار
# پیش‌فرض واقعیِ خوانده‌شده از خود کد، و اینکه اگر خالی بماند دقیقاً کدام
# قابلیت خاموش می‌شود.
#
# ⚠️ در این فایل هیچ مقدار واقعی و هیچ رمزی نیست — فقط placeholder.
#    مقدارهای واقعی فقط در .env محلی یا در پنل Vercel وارد می‌شوند.
#
# قانون پیشوند VITE_:
#   هر متغیری که با VITE_ شروع شود در زمان build داخل جاوااسکریپتی که هر
#   کاربر دانلود می‌کند کامپایل می‌شود. یعنی عمومی است، نه مخفی. هرگز رمز،
#   کلید خصوصی یا توکن نوشتنی را با پیشوند VITE_ نگذارید.
#
# اعتبارسنجی: node scripts/validate-activation-env.mjs
# راهنمای گام‌به‌گام فارسی: docs/ENV-FA.md
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
# ۱ — الزامی برای فعال‌سازی
# ═══════════════════════════════════════════════════════════════════════════
# بدون این دو، رجیستری اکوسیستم اصلاً فعال نمی‌شود.
# اسکریپت scripts/validate-activation-env.mjs دقیقاً همین دو را چک می‌کند و
# با خروج ۱ اعلام می‌کند کدام‌شان هنوز تنظیم نشده است.

# ذخیره‌سازی پایدار: Upstash Redis رایگان مسیر ترجیحی است. هر دو مقدار باید
# فقط در Environment Variables سرور باشند؛ هرگز VITE_ نگذارید. وقتی Upstash
# کامل تنظیم باشد، کد هیچ read/writeای به Vercel Blob نمی‌فرستد، حتی اگر توکن
# قدیمی Blob هنوز در محیط مانده باشد.
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# جایگزین اختیاری: Vercel Blob. اگر Upstash تنظیم نشده باشد استفاده می‌شود.
# فرمت مورد انتظار: ^vercel_blob_rw_
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN_HERE

# فهرست بازبین‌های مجاز به صدور گواهی، جداشده با کاما.
# پیش‌فرض در کد: '' — server/ecosystemCertifications.js
# اگر خالی بماند: هیچ‌کس نمی‌تواند گواهی صادر کند، پس هیچ لیستینگی منتشر
# نمی‌شود و کاتالوگ عمومی برای همیشه خالی می‌ماند.
# فرمت مورد انتظار: telegramUserId:Label  — مثال چندتایی: 111:Rev1,222:Rev2
ECOSYSTEM_CERTIFIERS=YOUR_TELEGRAM_ID:YOUR_LABEL


# ═══════════════════════════════════════════════════════════════════════════
# ۲ — الزامی برای این قابلیت خاص
# ═══════════════════════════════════════════════════════════════════════════
# هرکدام دقیقاً یک قابلیت را روشن می‌کند. نبودشان بقیهٔ اپ را نمی‌شکند؛ فقط
# همان قابلیت خاموش می‌ماند و اپ صادقانه می‌گوید در دسترس نیست.

# ─────────────────────────────────────────────────────────────
# ۲.۰ — Intent OS: شاهد عملیاتی و ارسال تراکنش
# ─────────────────────────────────────────────────────────────

# شاهدهای عملیاتی تأییدشدهٔ اپراتور، به شکل آرایهٔ JSON.
# پیش‌فرض در کد: '' — server/intentOperatorEvidence.js
# اگر خالی بماند: انبار شاهد خالی می‌ماند، /api/intents/v1/evidence-status
# مقدار 0/21 گزارش می‌دهد و launchAllowed برابر false است. این حالتِ درست و
# صادقانه برای یک استقرار تأییدنشده است، نه خطا.
# هر رکورد از همان اعتبارسنجی مسیر HTTP عبور می‌کند؛ رکورد نامعتبر، منقضی یا
# حاوی راز دور انداخته می‌شود. فقط digest عمومی — هرگز کلید خصوصی.
# قالب: [{"kind":"rpc","providerId":"...","digest":"<64 hex>",
#         "checkedAt":<ms>,"expiresAt":<ms>,"status":"verified",
#         "health":"healthy","attested":true}]
# راه بهتر: POST /api/intents/v1/operator-evidence با احراز هویت دو اپراتور.
INTENT_OPERATIONAL_EVIDENCE=

# اجازهٔ ارسال واقعی تراکنش از Intent OS به شبکه.
# پیش‌فرض در کد: خاموش — فقط رشتهٔ دقیق 'true' آن را روشن می‌کند
# (src/lib/intent-ai/draftTransactionBridge.js)
# اگر خالی بماند: Intent OS امضا و بررسی سیاست را انجام می‌دهد ولی چیزی به شبکه
# نمی‌فرستد؛ رسید با وضعیت صادقانهٔ authorized بسته می‌شود.
# روشن کردنش به‌تنهایی کافی نیست: هر اجرا به تأیید صریح کاربر هم نیاز دارد.
# هشدار: این متغیر باعث حرکت وجه واقعی می‌شود. اول روی تست‌نت.
VITE_INTENT_BROADCAST_ENABLED=

# ─────────────────────────────────────────────────────────────
# ۲.۱ — نوتیفیکیشن وب (Web Push)
# ─────────────────────────────────────────────────────────────

# کلید عمومی VAPID؛ مرورگر با همین کلید اشتراک پوش می‌سازد.
# پیش‌فرض در کد: '' — src/lib/notify.js و server/push.js
# اگر خالی بماند: دکمهٔ فعال‌سازی نوتیفیکیشن هیچ اشتراکی نمی‌سازد، pushConfigured
# برابر false می‌شود و هیچ نوتیفیکیشن وبی ارسال نمی‌شود.
# ساخت: node scripts/make-keys.mjs
VITE_VAPID_PUBLIC_KEY=

# همان کلید عمومی برای سمت سرور، وقتی نسخهٔ VITE_ در بیلد سرور نیست.
# پیش‌فرض در کد: مقدار VITE_VAPID_PUBLIC_KEY، وگرنه '' — server/push.js
# اگر خالی بماند: تا وقتی VITE_VAPID_PUBLIC_KEY تنظیم باشد اثری ندارد.
VAPID_PUBLIC_KEY=

# 🔒 کلید خصوصی VAPID؛ امضای هر نوتیفیکیشن با این انجام می‌شود.
# پیش‌فرض در کد: '' — server/push.js
# اگر خالی بماند: pushConfigured برابر false و هیچ پوشی ارسال نمی‌شود.
VAPID_PRIVATE_KEY=

# آدرس تماس داخل هدر VAPID (الزام استاندارد).
# پیش‌فرض در کد: 'mailto:support@example.com' — server/push.js
# اگر خالی بماند: پیش‌فرض به کار می‌رود؛ بعضی سرویس‌های پوش آدرس واقعی می‌خواهند.
VAPID_SUBJECT=

# ─────────────────────────────────────────────────────────────
# ۲.۲ — نوتیفیکیشن اندروید (Firebase Cloud Messaging)
# ─────────────────────────────────────────────────────────────
# هر سه با هم لازم‌اند؛ یکی کم باشد کل FCM خاموش است.

# شناسهٔ پروژهٔ فایربیس، از فایل JSON سرویس‌اکانت.
# پیش‌فرض در کد: '' — server/fcm.js
# اگر خالی بماند: ارسال نوتیفیکیشن به اپ اندروید کار نمی‌کند.
FIREBASE_PROJECT_ID=

# ایمیل سرویس‌اکانت، از همان فایل JSON.
# پیش‌فرض در کد: '' — server/fcm.js
# اگر خالی بماند: همان بالا — FCM خاموش.
FIREBASE_CLIENT_EMAIL=

# 🔒🔒 کلید خصوصی سرویس‌اکانت. دنباله‌های \n را دست‌نخورده بگذارید.
# پیش‌فرض در کد: '' — server/fcm.js
# اگر خالی بماند: FCM خاموش. اگر \n ها را به خط واقعی تبدیل کنید خطای
# invalid_grant می‌گیرید — جزئیات در docs/ENV-FA.md.
FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# ۲.۳ — همگام‌سازی تنظیمات کاربر (Firebase سمت مرورگر)
# ─────────────────────────────────────────────────────────────
# اینها عمومی‌اند (کلید وب فایربیس رمز نیست) ولی همه با هم لازم‌اند.
# اگر هرکدام خالی بماند: firebaseConfigured برابر false می‌شود، بخش «همگام‌سازی»
# در تنظیمات اصلاً رندر نمی‌شود و تنظیمات فقط روی همین دستگاه می‌ماند.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# ۲.۴ — کران‌جاب‌های زمان‌بندی‌شده
# ─────────────────────────────────────────────────────────────

# 🔒 رمز محافظ مسیرهای /api/cron/*.
# پیش‌فرض در کد: '' — server/app.js
# اگر خالی بماند: هر فراخوانی کران با UNAUTHORIZED رد می‌شود، پس خلاصهٔ روزانه
# و هشدارهای زمان‌بندی‌شده اجرا نمی‌شوند. (این fail-closed عمدی است.)
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# ۲.۵ — ربات تلگرام و Mini App
# ─────────────────────────────────────────────────────────────

# 🔒 توکن ربات؛ اعتبارسنجی initData امضاشدهٔ تلگرام با همین انجام می‌شود.
# پیش‌فرض در کد: '' — server/app.js و server/index.js
# اگر خالی بماند: ورود از طریق Mini App تأیید نمی‌شود، کنسول توسعه‌دهنده/بازبین
# باز نمی‌شود و صدور گواهی ممکن نیست.
TELEGRAM_BOT_TOKEN=

# نام کاربری عمومی ربات (بدون @) — فقط برای ساختن لینک t.me.
# پیش‌فرض در کد: 'fbtco_bot' — src/lib/telegramBot.js
# اگر خالی بماند: همان پیش‌فرض استفاده می‌شود.
VITE_TELEGRAM_BOT_USERNAME=

# شناسهٔ عددی عمومی ربات — فقط اطلاعاتی، هرگز کلید احراز هویت نیست.
# پیش‌فرض در کد: '7837421575' — src/lib/telegramBot.js
# اگر خالی بماند: همان پیش‌فرض استفاده می‌شود.
VITE_TELEGRAM_BOT_ID=

# نسخهٔ سمت سرور همان شناسه، برای تطبیق با توکن.
# پیش‌فرض در کد: '7837421575' — server/telegramIdentity.js
# اگر خالی بماند: همان پیش‌فرض استفاده می‌شود.
TELEGRAM_BOT_ID=

# نام کاربری ربات برای سرور.
# پیش‌فرض در کد: '' — server/app.js
TELEGRAM_BOT_USERNAME=

# شناسهٔ کانالی که scripts/channel-post.mjs در آن پست می‌گذارد.
# پیش‌فرض در کد: '' — scripts/channel-post.mjs
# اگر خالی بماند: انتشار خودکار در کانال انجام نمی‌شود.
TELEGRAM_CHANNEL_ID=

# آدرس عمومی وب‌اپ، برای دکمهٔ Mini App.
# پیش‌فرض در کد: 'https://fbt-swap.app' یا 'https://fbtswap.ir' بسته به فایل
# — server/index.js و server/ai.js
WEBAPP_URL=

# ─────────────────────────────────────────────────────────────
# ۲.۶ — دستیار هوش مصنوعی
# ─────────────────────────────────────────────────────────────
# اگر هیچ‌کدام از این کلیدها نباشد: دستیار صادقانه می‌گوید در دسترس نیست.
# هیچ جواب ساختگی تولید نمی‌شود.

# کلید OpenRouter (مسیر اصلی).
# پیش‌فرض در کد: '' — server/ai.js
OPENROUTER_API_KEY=

# کلید Groq (مسیر جایگزین).
# پیش‌فرض در کد: '' — server/ai.js
GROQ_API_KEY=

# مدل Groq.
# پیش‌فرض در کد: 'openai/gpt-oss-20b' — server/ai.js
GROQ_MODEL=

# کلید Gemini سمت سرور.
# پیش‌فرض در کد: '' — server/ai.js
GEMINI_API_KEY=

# مدل Gemini سمت سرور.
# پیش‌فرض در کد: 'gemini-2.0-flash' — server/ai.js
GEMINI_MODEL=

# مدل پیش‌فرض OpenRouter.
# پیش‌فرض در کد: 'openai/gpt-4o-mini' — server/ai.js
AI_MODEL=

# کلید Jina برای خواندن صفحات وب در پاسخ‌های تحلیلی.
# پیش‌فرض در کد: '' — server/ai.js
# اگر خالی بماند: دستیار نمی‌تواند محتوای لینک را بخواند؛ بقیهٔ پاسخ‌ها کار می‌کنند.
JINA_API_KEY=

# ⚠️ کلید Gemini داخل بیلد اندروید (قابل استخراج از APK).
# پیش‌فرض در کد: '' — src/lib/geminiDirect.js
# اگر خالی بماند: اپ اندروید از مسیر سرور استفاده می‌کند (رفتار امن‌تر).
# فقط با «Android API key restriction» فعالش کنید.
VITE_GEMINI_API_KEY=

# مدل Gemini در مسیر مستقیم اندروید.
# پیش‌فرض در کد: 'gemini-2.0-flash' — src/lib/geminiDirect.js
VITE_GEMINI_MODEL=

# ─────────────────────────────────────────────────────────────
# ۲.۷ — دادهٔ بازار
# ─────────────────────────────────────────────────────────────

# کلید CoinGecko.
# پیش‌فرض در کد: '' — server/coinIndex.js
# اگر خالی بماند: از پلن رایگان با محدودیت نرخ استفاده می‌شود؛ در ترافیک بالا
# بعضی درخواست‌ها ۴۲۹ می‌گیرند و صفحه می‌گوید داده در دسترس نیست.
COINGECKO_API_KEY=

# انتخاب endpoint پرو در برابر رایگان.
# پیش‌فرض در کد: بدون مقدار = رایگان (فقط 'pro' معنی دارد) — server/coinIndex.js
COINGECKO_PLAN=

# آدرس پایهٔ CoinGecko.
# پیش‌فرض در کد: 'https://api.coingecko.com/api/v3' — server/coinIndex.js
COINGECKO_BASE=

# کلید Solscan برای دادهٔ زنجیرهٔ سولانا.
# پیش‌فرض در کد: '' — server/solanaIntel.js
# اگر خالی بماند: بخش تحلیل سولانا داده ندارد و خالی می‌ماند.
SOLSCAN_API_KEY=

# آدرس پایهٔ Solscan.
# پیش‌فرض در کد: 'https://pro-api.solscan.io/v2.0' — server/solanaIntel.js
SOLSCAN_BASE=

# کلید Alchemy برای خواندن NFT.
# پیش‌فرض در کد: '' — server/nft.js
# اگر خالی بماند: فهرست NFT خالی برمی‌گردد.
ALCHEMY_API_KEY=

# آدرس پایهٔ دادهٔ بیت‌کوین.
# پیش‌فرض در کد: BTC_API_DEFAULT داخل server/btcChain.js
BTC_API_BASE=

# ─────────────────────────────────────────────────────────────
# ۲.۸ — مسیرهای سواپ و بریج
# ─────────────────────────────────────────────────────────────

# کلید LI.FI (بریج).
# پیش‌فرض در کد: '' — server/bridge.js
# اگر خالی بماند: نرخ‌های عمومی LI.FI هنوز می‌آیند، ولی بدون سهم کارمزد.
LIFI_API_KEY=

# شناسهٔ integrator در LI.FI.
# پیش‌فرض در کد: 'fbt-swap' — server/bridge.js
LIFI_INTEGRATOR=

# سهم کارمزد LI.FI به‌صورت اعشاری.
# پیش‌فرض در کد: 0.003 — server/bridge.js
LIFI_FEE=

# سوییچ صریح فعال‌سازی کارمزد بریج.
# پیش‌فرض در کد: بدون مقدار = false (فقط 'true' فعالش می‌کند) — server/bridge.js
# اگر خالی بماند: کارمزد بریج دریافت نمی‌شود. این fail-closed عمدی است.
LIFI_FEE_READY=false

# کلید 0x برای سواپ بدون گس.
# پیش‌فرض در کد: '' — server/gasless.js
# اگر خالی بماند: مسیر gasless در دسترس نیست و اپ همین را می‌گوید.
ZEROX_API_KEY=

# کارمزد 0x بر حسب bps.
# پیش‌فرض در کد: مقدار FEE_BPS، وگرنه 70 — server/gasless.js
ZEROX_FEE_BPS=

# آدرس دریافت کارمزد 0x.
# پیش‌فرض در کد: مقدار VITE_PAYOUT_EVM — server/gasless.js
ZEROX_FEE_RECIPIENT=

# کلید Jupiter (سواپ سولانا).
# پیش‌فرض در کد: '' — server/solana.js
JUPITER_API_KEY=

# حساب ارجاع Jupiter برای دریافت کارمزد سولانا.
# پیش‌فرض در کد: '' — server/solana.js
# اگر خالی بماند: سواپ سولانا کار می‌کند ولی کارمزدی جمع نمی‌شود.
JUP_REFERRAL_ACCOUNT=
VITE_JUP_REFERRAL_ACCOUNT=

# کلید OpenOcean (مسیر جایگزین سولانا).
# پیش‌فرض در کد: '' — server/solanaOcean.js
OPENOCEAN_API_KEY=

# آدرس پایهٔ OpenOcean.
# پیش‌فرض در کد: 'https://open-api-enterprise.de1.exchange/v4' — server/solanaOcean.js
OPENOCEAN_BASE_URL=

# کارمزد سولانا بر حسب bps.
# پیش‌فرض در کد: مقدار FEE_BPS، وگرنه 70 — server/solanaOcean.js
SOLANA_FEE_BPS=

# آدرس دریافت کارمزد سولانا.
# پیش‌فرض در کد: مقدار VITE_PAYOUT_SOLANA — server/solanaOcean.js
SOLANA_FEE_RECIPIENT=

# آدرس نود THORChain.
# پیش‌فرض در کد: فهرست نودهای عمومی داخل server/thorchain.js
THORNODE_BASE=

# آدرس عمومی دریافت سهم THORChain (فقط آدرس دریافت، فرمتش چک می‌شود).
# پیش‌فرض در کد: 'thor12cqv53jqz6tnzmlsg9y207xe83raeem8nywqxt' — server/thorchain.js
# ⚠️ NEVER put a recovery phrase or private key here — اینجا فقط آدرس می‌آید.
# گذاشتن عبارت بازیابی (recovery phrase) در این متغیر یعنی از دست دادن کل دارایی.
THOR_AFFILIATE=
VITE_THOR_AFFILIATE=

# سهم THORChain بر حسب bps.
# پیش‌فرض در کد: 70 — server/thorchain.js و src/lib/thorchain.js
THOR_AFFILIATE_BPS=
VITE_THOR_AFFILIATE_BPS=

# نام نمایشی affiliate در THORChain.
# پیش‌فرض در کد: '' — server/thorchain.js
THOR_NAME=

# نرخ deBridge بر حسب درصد.
# پیش‌فرض در کد: 0.4 — server/dln.js
# ⚠️ این عدد را بالا نبرید. At 0.7% it moves the user to the worse side once
# the fixed protocol fee is included — یعنی کاربر عملاً ضرر می‌کند.
DLN_FEE_PERCENT=0.4

