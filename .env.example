VITE_ENABLE_SPECULATION=

# یادگیری سمت سرور. پیش‌فرض در کد: روشن، مگر برابر '0' باشد — server/app.js
LEARNING_ENABLED=

# BUY / SELL provider activation — RAMP NETWORK (Hosted Mode)
# ارائه‌دهندهٔ اصلی Buy/Sell رمپ نتورک است (Hosted Checkout رسمی)، نه هیچ API معاملاتی صرافی.
# بدون این مقادیر، وضعیت ارائه‌دهنده CONFIGURATION_REQUIRED می‌ماند و هیچ پرداختی
# ساخته یا شبیه‌سازی نمی‌شود. این مقادیر فقط پس از تأیید و فعال‌سازی قانونی حساب
# تولید توسط خود Ramp (Partner/KYB/Terms) معنا دارند؛ هیچ متغیری محدودیت کشور،
# KYC یا تحریم را دور نمی‌زند — آن تصمیم‌ها همیشه با خود Ramp است.
#
# RAMP_HOST_API_KEY: کلید Host API تولید که Ramp رسماً برای Hosted Mode صادر می‌کند.
#   این یک «اعتبارنامهٔ یکپارچه‌سازی Ramp» است، نه API معاملاتی CEX. فقط سمت سرور؛ هرگز در Git یا فرانت‌اند.
RAMP_HOST_API_KEY=
# RAMP_ENVIRONMENT: production (پیش‌فرض) یا demo — میزبان‌های رسمی app.rampnetwork.com / app.demo.rampnetwork.com
RAMP_ENVIRONMENT=
# نام و لوگوی نمایش‌دادنی در ویجت رسمی (پارامترهای مستند hostAppName / hostLogoUrl)
RAMP_HOST_APP_NAME=
RAMP_HOST_LOGO_URL=
# RAMP_ENABLED_FLOWS: ONRAMP (پیش‌فرض) یا ONRAMP,OFFRAMP — فروش فقط وقتی فعال می‌شود که
# یکپارچه‌سازی تأییدشدهٔ Ramp آن را پشتیبانی کند؛ در غیر این صورت SELL_UNAVAILABLE صادقانه می‌ماند.
RAMP_ENABLED_FLOWS=
# RAMP_FINAL_URL_BASE: مبدأ عمومی اپ برای بازگشت کاربر (finalUrl → /order/result/:orderId)
RAMP_FINAL_URL_BASE=
# RAMP_WEBHOOK_STATUS_URL: آدرس عمومی وب‌هوک امضاشدهٔ Ramp
#   (…/api/v1/buy-sell/webhooks/ramp). بدون آن هش تراکنش تسویه هرگز به‌طور مشروع
#   دریافت نمی‌شود، پس ارائه‌دهنده عمداً غیرفعال می‌ماند.
RAMP_WEBHOOK_STATUS_URL=
# RAMP_WEBHOOK_PUBLIC_KEY_PEM: کلید عمومی ECDSA رسمی Ramp (PEM) برای تأیید X-Body-Signature.
#   هر callback بدون امضای معتبر رد می‌شود و هرگز به‌عنوان تسویه پردازش نمی‌شود.
RAMP_WEBHOOK_PUBLIC_KEY_PEM=
# مقادیر عمومی lifecycle داخلی (به‌تنهایی پرداخت را فعال نمی‌کنند):
BUY_SELL_QUOTE_TTL_MS=
BUY_SELL_ORDER_TTL_MS=
BUY_SELL_MIN_CONFIRMATIONS=
BUY_SELL_PAYMENT_RATE_LIMIT=

# محدودیت نرخ درخواست‌ها. پیش‌فرض‌ها در server/app.js:
