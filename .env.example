# ═══════════════════════════════════════════════════════════════════════════
# FBT — الگوی متغیرهای محیطی
# ═══════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env
#
# هر متغیری که در کد خوانده می‌شود اینجا هست، با یک خط توضیح فارسی، مقدار
# پیش‌فرض واقعیِ خوانده‌شده از خود کد، و اینکه اگر خالی بماند دقیقاً کدام
# قابلیت خاموش می‌شود.
#
# ⚠️ در این فایل هیچ مقدار واقعی و هیچ رمزی نیست — فقط placeholder.
#    مقدارهای واقعی فقط در .env محلی یا در پنل Vercel وارد می‌شوند.
#
# قانون پیشوند VITE_:
#   هر متغیری که با VITE_ شروع شود در زمان build داخل جاوااسکریپتی که هر
#   کاربر دانلود می‌کند کامپایل می‌شود. یعنی عمومی است، نه مخفی. هرگز رمز،
#   کلید خصوصی یا توکن نوشتنی را با پیشوند VITE_ نگذارید.
#
# اعتبارسنجی: node scripts/validate-activation-env.mjs
# راهنمای گام‌به‌گام فارسی: docs/ENV-FA.md
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
# ۱ — الزامی برای فعال‌سازی
# ═══════════════════════════════════════════════════════════════════════════
# بدون این دو، رجیستری اکوسیستم اصلاً فعال نمی‌شود.
# اسکریپت scripts/validate-activation-env.mjs دقیقاً همین دو را چک می‌کند و
# با خروج ۱ اعلام می‌کند کدام‌شان هنوز تنظیم نشده است.

# ذخیره‌سازی پایدار: Upstash Redis رایگان مسیر ترجیحی است. هر دو مقدار باید
# فقط در Environment Variables سرور باشند؛ هرگز VITE_ نگذارید. وقتی Upstash
# کامل تنظیم باشد، کد هیچ read/writeای به Vercel Blob نمی‌فرستد، حتی اگر توکن
# قدیمی Blob هنوز در محیط مانده باشد.
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# جایگزین اختیاری: Vercel Blob. اگر Upstash تنظیم نشده باشد استفاده می‌شود.
# فرمت مورد انتظار: ^vercel_blob_rw_
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN_HERE

# فهرست بازبین‌های مجاز به صدور گواهی، جداشده با کاما.
# پیش‌فرض در کد: '' — server/ecosystemCertifications.js
# اگر خالی بماند: هیچ‌کس نمی‌تواند گواهی صادر کند، پس هیچ لیستینگی منتشر
# نمی‌شود و کاتالوگ عمومی برای همیشه خالی می‌ماند.
# فرمت مورد انتظار: telegramUserId:Label  — مثال چندتایی: 111:Rev1,222:Rev2
ECOSYSTEM_CERTIFIERS=YOUR_TELEGRAM_ID:YOUR_LABEL


# ═══════════════════════════════════════════════════════════════════════════
# ۲ — الزامی برای این قابلیت خاص
# ═══════════════════════════════════════════════════════════════════════════
# هرکدام دقیقاً یک قابلیت را روشن می‌کند. نبودشان بقیهٔ اپ را نمی‌شکند؛ فقط
# همان قابلیت خاموش می‌ماند و اپ صادقانه می‌گوید در دسترس نیست.

# ─────────────────────────────────────────────────────────────
# ۲.۰ — Intent OS: شاهد عملیاتی و ارسال تراکنش
# ─────────────────────────────────────────────────────────────

# شاهدهای عملیاتی تأییدشدهٔ اپراتور، به شکل آرایهٔ JSON.
# پیش‌فرض در کد: '' — server/intentOperatorEvidence.js
# اگر خالی بماند: انبار شاهد خالی می‌ماند، /api/intents/v1/evidence-status
# مقدار 0/21 گزارش می‌دهد و launchAllowed برابر false است. این حالتِ درست و
# صادقانه برای یک استقرار تأییدنشده است، نه خطا.
# هر رکورد از همان اعتبارسنجی مسیر HTTP عبور می‌کند؛ رکورد نامعتبر، منقضی یا
# حاوی راز دور انداخته می‌شود. فقط digest عمومی — هرگز کلید خصوصی.
# قالب: [{"kind":"rpc","providerId":"...","digest":"<64 hex>",
#         "checkedAt":<ms>,"expiresAt":<ms>,"status":"verified",
#         "health":"healthy","attested":true}]
# راه بهتر: POST /api/intents/v1/operator-evidence با احراز هویت دو اپراتور.
INTENT_OPERATIONAL_EVIDENCE=

# ── اپراتور سندباکس (فقط توسعه/پیش‌نمایش) ───────────────────────────────────
# وقتی روشن باشد، سرور یک اپراتور سندباکس داخلی اجرا می‌کند که ۲۱ نوع شواهد را
# خود-تصدیق می‌کند تا صفحهٔ Settings → Intent AI Activation در دموها کامل کار
# کند؛ همین دروازه کلید هماهنگ‌کننده و توکن بستن مزایده را هم به‌صورت محلی می‌سازد.
#   INTENT_AI_SANDBOX_EVIDENCE=1   # روشن اجباری (حتی در production)
#   INTENT_AI_SANDBOX_EVIDENCE=0   # خاموش اجباری (production fail-closed)
# پیش‌فرض: در dev/preview روشن، در production خاموش؛ NODE_ENV=test هم خاموش می‌کند.
# هشدار: شواهد سندباکس خود-تصدیق‌شده است — فعال‌سازی تولید فقط با شواهد
# بازبینی‌شدهٔ بیرونی (همین INTENT_OPERATIONAL_EVIDENCE یا مسیر HTTP) واقعی می‌شود.
INTENT_AI_SANDBOX_EVIDENCE=

# اجازهٔ ارسال واقعی تراکنش از Intent OS به شبکه.
# پیش‌فرض در کد: خاموش — فقط رشتهٔ دقیق 'true' آن را روشن می‌کند
# (src/lib/intent-ai/draftTransactionBridge.js)
# اگر خالی بماند: Intent OS امضا و بررسی سیاست را انجام می‌دهد ولی چیزی به شبکه
# نمی‌فرستد؛ رسید با وضعیت صادقانهٔ authorized بسته می‌شود.
# روشن کردنش به‌تنهایی کافی نیست: هر اجرا به تأیید صریح کاربر هم نیاز دارد.
# هشدار: این متغیر باعث حرکت وجه واقعی می‌شود. اول روی تست‌نت.
VITE_INTENT_BROADCAST_ENABLED=

# ─────────────────────────────────────────────────────────────
# ۲.۱ — نوتیفیکیشن وب (Web Push)
# ─────────────────────────────────────────────────────────────

# کلید عمومی VAPID؛ مرورگر با همین کلید اشتراک پوش می‌سازد.
# پیش‌فرض در کد: '' — src/lib/notify.js و server/push.js
# اگر خالی بماند: دکمهٔ فعال‌سازی نوتیفیکیشن هیچ اشتراکی نمی‌سازد، pushConfigured
# برابر false می‌شود و هیچ نوتیفیکیشن وبی ارسال نمی‌شود.
# ساخت: node scripts/make-keys.mjs
VITE_VAPID_PUBLIC_KEY=

# همان کلید عمومی برای سمت سرور، وقتی نسخهٔ VITE_ در بیلد سرور نیست.
# پیش‌فرض در کد: مقدار VITE_VAPID_PUBLIC_KEY، وگرنه '' — server/push.js
# اگر خالی بماند: تا وقتی VITE_VAPID_PUBLIC_KEY تنظیم باشد اثری ندارد.
VAPID_PUBLIC_KEY=

# 🔒 کلید خصوصی VAPID؛ امضای هر نوتیفیکیشن با این انجام می‌شود.
# پیش‌فرض در کد: '' — server/push.js
# اگر خالی بماند: pushConfigured برابر false و هیچ پوشی ارسال نمی‌شود.
VAPID_PRIVATE_KEY=

# آدرس تماس داخل هدر VAPID (الزام استاندارد).
# پیش‌فرض در کد: 'mailto:support@example.com' — server/push.js
# اگر خالی بماند: پیش‌فرض به کار می‌رود؛ بعضی سرویس‌های پوش آدرس واقعی می‌خواهند.
VAPID_SUBJECT=

# ─────────────────────────────────────────────────────────────
# ۲.۲ — نوتیفیکیشن اندروید (Firebase Cloud Messaging)
# ─────────────────────────────────────────────────────────────
# هر سه با هم لازم‌اند؛ یکی کم باشد کل FCM خاموش است.

# شناسهٔ پروژهٔ فایربیس، از فایل JSON سرویس‌اکانت.
# پیش‌فرض در کد: '' — server/fcm.js
# اگر خالی بماند: ارسال نوتیفیکیشن به اپ اندروید کار نمی‌کند.
FIREBASE_PROJECT_ID=

# ایمیل سرویس‌اکانت، از همان فایل JSON.
# پیش‌فرض در کد: '' — server/fcm.js
# اگر خالی بماند: همان بالا — FCM خاموش.
FIREBASE_CLIENT_EMAIL=

# 🔒🔒 کلید خصوصی سرویس‌اکانت. دنباله‌های \n را دست‌نخورده بگذارید.
# پیش‌فرض در کد: '' — server/fcm.js
# اگر خالی بماند: FCM خاموش. اگر \n ها را به خط واقعی تبدیل کنید خطای
# invalid_grant می‌گیرید — جزئیات در docs/ENV-FA.md.
FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# ۲.۳ — همگام‌سازی تنظیمات کاربر (Firebase سمت مرورگر)
# ─────────────────────────────────────────────────────────────
# اینها عمومی‌اند (کلید وب فایربیس رمز نیست) ولی همه با هم لازم‌اند.
# اگر هرکدام خالی بماند: firebaseConfigured برابر false می‌شود، بخش «همگام‌سازی»
# در تنظیمات اصلاً رندر نمی‌شود و تنظیمات فقط روی همین دستگاه می‌ماند.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# ۲.۴ — کران‌جاب‌های زمان‌بندی‌شده
# ─────────────────────────────────────────────────────────────

# 🔒 رمز محافظ مسیرهای /api/cron/*.
# پیش‌فرض در کد: '' — server/app.js
# اگر خالی بماند: هر فراخوانی کران با UNAUTHORIZED رد می‌شود، پس خلاصهٔ روزانه
# و هشدارهای زمان‌بندی‌شده اجرا نمی‌شوند. (این fail-closed عمدی است.)
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# ۲.۵ — ربات تلگرام و Mini App
# ─────────────────────────────────────────────────────────────

# 🔒 توکن ربات؛ اعتبارسنجی initData امضاشدهٔ تلگرام با همین انجام می‌شود.
# پیش‌فرض در کد: '' — server/app.js و server/index.js
# اگر خالی بماند: ورود از طریق Mini App تأیید نمی‌شود، کنسول توسعه‌دهنده/بازبین
# باز نمی‌شود و صدور گواهی ممکن نیست.
TELEGRAM_BOT_TOKEN=

# نام کاربری عمومی ربات (بدون @) — فقط برای ساختن لینک t.me.
# پیش‌فرض در کد: 'fbtco_bot' — src/lib/telegramBot.js
# اگر خالی بماند: همان پیش‌فرض استفاده می‌شود.
VITE_TELEGRAM_BOT_USERNAME=

# شناسهٔ عددی عمومی ربات — فقط اطلاعاتی، هرگز کلید احراز هویت نیست.
# پیش‌فرض در کد: '7837421575' — src/lib/telegramBot.js
# اگر خالی بماند: همان پیش‌فرض استفاده می‌شود.
VITE_TELEGRAM_BOT_ID=

# نسخهٔ سمت سرور همان شناسه، برای تطبیق با توکن.
# پیش‌فرض در کد: '7837421575' — server/telegramIdentity.js
# اگر خالی بماند: همان پیش‌فرض استفاده می‌شود.
TELEGRAM_BOT_ID=

# نام کاربری ربات برای سرور.
# پیش‌فرض در کد: '' — server/app.js
TELEGRAM_BOT_USERNAME=

# شناسهٔ کانالی که scripts/channel-post.mjs در آن پست می‌گذارد.
# پیش‌فرض در کد: '' — scripts/channel-post.mjs
# اگر خالی بماند: انتشار خودکار در کانال انجام نمی‌شود.
TELEGRAM_CHANNEL_ID=

# آدرس عمومی وب‌اپ، برای دکمهٔ Mini App.
# پیش‌فرض در کد: 'https://fbt-swap.app' یا 'https://fbtswap.ir' بسته به فایل
# — server/index.js و server/ai.js
WEBAPP_URL=

# ─────────────────────────────────────────────────────────────
# ۲.۶ — دستیار هوش مصنوعی و لایه Multi-AI Gateway
# ─────────────────────────────────────────────────────────────
# اگر هیچ‌کدام از این کلیدها نباشد: سیستم از موتور هوش داخلی (Internal Heuristic) استفاده می‌کند.
# هیچ داده یا موجودی ساختگی تولید نمی‌شود.

# کلید Grok (xAI) برای تحلیل هوشمند بازار و اخبار کلان.
GROK_API_KEY=
# کلید جایگزین xAI
XAI_API_KEY=

# کلید OpenRouter (مسیر مدل‌های چندگانه: Claude, DeepSeek, GPT-4o, Llama-3).
OPENROUTER_API_KEY=

# کلید Groq (مسیر با تأخیر بسیار پایین).
GROQ_API_KEY=
GROQ_MODEL=

# کلید Google Gemini سمت سرور.
GEMINI_API_KEY=
GEMINI_MODEL=

# کلید Anthropic Claude (تحلیل عمیق ریسک و امنیت).
ANTHROPIC_API_KEY=

# کلید DeepSeek (مدل‌سازی محاسباتی و بهینه‌سازی).
DEEPSEEK_API_KEY=

# کلید OpenAI (GPT-4o / GPT-4o-mini).
OPENAI_API_KEY=

# کلید Perplexity (جستجوی لحظه‌ای وب و اخبار).
PERPLEXITY_API_KEY=

# کلید Mistral AI
MISTRAL_API_KEY=

# مدل پیش‌فرض OpenRouter.
# پیش‌فرض در کد: 'openai/gpt-4o-mini' — server/ai.js
AI_MODEL=

# کلید Jina برای خواندن صفحات وب در پاسخ‌های تحلیلی.
JINA_API_KEY=

# ⚠️ کلید Gemini داخل بیلد اندروید (قابل استخراج از APK).
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=

# ─────────────────────────────────────────────────────────────
# ۲.۷ — دادهٔ بازار
# ─────────────────────────────────────────────────────────────

# کلید CoinGecko.
# پیش‌فرض در کد: '' — server/coinIndex.js
# اگر خالی بماند: از پلن رایگان با محدودیت نرخ استفاده می‌شود؛ در ترافیک بالا
# بعضی درخواست‌ها ۴۲۹ می‌گیرند و صفحه می‌گوید داده در دسترس نیست.
COINGECKO_API_KEY=

# انتخاب endpoint پرو در برابر رایگان.
# پیش‌فرض در کد: بدون مقدار = رایگان (فقط 'pro' معنی دارد) — server/coinIndex.js
COINGECKO_PLAN=

# آدرس پایهٔ CoinGecko.
# پیش‌فرض در کد: 'https://api.coingecko.com/api/v3' — server/coinIndex.js
COINGECKO_BASE=

# کلید Solscan برای دادهٔ زنجیرهٔ سولانا.
# پیش‌فرض در کد: '' — server/solanaIntel.js
# اگر خالی بماند: بخش تحلیل سولانا داده ندارد و خالی می‌ماند.
SOLSCAN_API_KEY=

# آدرس پایهٔ Solscan.
# پیش‌فرض در کد: 'https://pro-api.solscan.io/v2.0' — server/solanaIntel.js
SOLSCAN_BASE=

# کلید Alchemy برای خواندن NFT.
# پیش‌فرض در کد: '' — server/nft.js
# اگر خالی بماند: فهرست NFT خالی برمی‌گردد.
ALCHEMY_API_KEY=

# آدرس پایهٔ دادهٔ بیت‌کوین.
# پیش‌فرض در کد: BTC_API_DEFAULT داخل server/btcChain.js
BTC_API_BASE=

# ─────────────────────────────────────────────────────────────
# ۲.۸ — مسیرهای سواپ و بریج
# ─────────────────────────────────────────────────────────────

# کلید LI.FI (بریج و مسیرهای میان‌زنجیره‌ای).
# پیش‌فرض در کد: '' — server/lifi.js (تنها کلاینت LI.FI؛ صفحه Bridge و تب
# «میان‌زنجیره‌ای» در Intent OS هر دو از همین یک ماژول عبور می‌کنند)
# اگر خالی بماند: نرخ‌های عمومی LI.FI هنوز می‌آیند، ولی سقف نرخ درخواست پایین‌تر است.
LIFI_API_KEY=

# شناسهٔ integrator در LI.FI.
# پیش‌فرض در کد: 'fbt-swap' — server/lifi.js
LIFI_INTEGRATOR=

# سهم کارمزد LI.FI به‌صورت اعشاری.
# پیش‌فرض در کد: 0.003 — server/lifi.js (سقف سخت ۰٫۰۱)
LIFI_FEE=

# سوییچ صریح فعال‌سازی کارمزد بریج.
# پیش‌فرض در کد: بدون مقدار = false (فقط 'true' فعالش می‌کند) — server/lifi.js
# اگر خالی بماند: کارمزد بریج دریافت نمی‌شود. این fail-closed عمدی است.
LIFI_FEE_READY=false

# آدرس پایهٔ API لی‌فای. فقط برای تست/محیط اختصاصی تغییرش بدهید.
# پیش‌فرض در کد: 'https://li.quest/v1' — server/lifi.js
LIFI_BASE_URL=

# طول عمر کش فهرست شبکه‌ها/توکن‌ها/پل‌ها به میلی‌ثانیه.
# پیش‌فرض در کد: 600000 (۱۰ دقیقه) — server/lifi.js
# نرخ‌ها هرگز کش نمی‌شوند؛ فقط همین فهرست‌های کم‌تغییر.
LIFI_REGISTRY_TTL_MS=

# کلید 0x برای سواپ بدون گس.
# پیش‌فرض در کد: '' — server/gasless.js
# اگر خالی بماند: مسیر gasless در دسترس نیست و اپ همین را می‌گوید.
ZEROX_API_KEY=

# کارمزد 0x بر حسب bps.
# پیش‌فرض در کد: مقدار FEE_BPS، وگرنه 70 — server/gasless.js
ZEROX_FEE_BPS=

# آدرس دریافت کارمزد 0x.
# پیش‌فرض در کد: مقدار VITE_PAYOUT_EVM — server/gasless.js
ZEROX_FEE_RECIPIENT=

# کلید Jupiter (سواپ سولانا).
# پیش‌فرض در کد: '' — server/solana.js
JUPITER_API_KEY=

# حساب ارجاع Jupiter برای دریافت کارمزد سولانا.
# پیش‌فرض در کد: '' — server/solana.js
# اگر خالی بماند: سواپ سولانا کار می‌کند ولی کارمزدی جمع نمی‌شود.
JUP_REFERRAL_ACCOUNT=
VITE_JUP_REFERRAL_ACCOUNT=

# کلید OpenOcean (مسیر جایگزین سولانا).
# پیش‌فرض در کد: '' — server/solanaOcean.js
OPENOCEAN_API_KEY=

# آدرس پایهٔ OpenOcean.
# پیش‌فرض در کد: 'https://open-api-enterprise.de1.exchange/v4' — server/solanaOcean.js
OPENOCEAN_BASE_URL=

# کارمزد سولانا بر حسب bps.
# پیش‌فرض در کد: مقدار FEE_BPS، وگرنه 70 — server/solanaOcean.js
SOLANA_FEE_BPS=

# آدرس دریافت کارمزد سولانا.
# پیش‌فرض در کد: مقدار VITE_PAYOUT_SOLANA — server/solanaOcean.js
SOLANA_FEE_RECIPIENT=

# آدرس نود THORChain.
# پیش‌فرض در کد: فهرست نودهای عمومی داخل server/thorchain.js
THORNODE_BASE=

# آدرس عمومی دریافت سهم THORChain (فقط آدرس دریافت، فرمتش چک می‌شود).
# پیش‌فرض در کد: 'thor12cqv53jqz6tnzmlsg9y207xe83raeem8nywqxt' — server/thorchain.js
# ⚠️ NEVER put a recovery phrase or private key here — اینجا فقط آدرس می‌آید.
# گذاشتن عبارت بازیابی (recovery phrase) در این متغیر یعنی از دست دادن کل دارایی.
THOR_AFFILIATE=
VITE_THOR_AFFILIATE=

# سهم THORChain بر حسب bps.
# پیش‌فرض در کد: 70 — server/thorchain.js و src/lib/thorchain.js
THOR_AFFILIATE_BPS=
VITE_THOR_AFFILIATE_BPS=

# نام نمایشی affiliate در THORChain.
# پیش‌فرض در کد: '' — server/thorchain.js
THOR_NAME=

# نرخ deBridge بر حسب درصد.
# پیش‌فرض در کد: 0.4 — server/dln.js
# ⚠️ این عدد را بالا نبرید. At 0.7% it moves the user to the worse side once
# the fixed protocol fee is included — یعنی کاربر عملاً ضرر می‌کند.
DLN_FEE_PERCENT=0.4

# آدرس‌های دریافت کارمزد deBridge.
# پیش‌فرض DLN_FEE_EVM در کد: مقدار VITE_FEE_RECIPIENT — server/dln.js
# پیش‌فرض DLN_FEE_SOLANA و DLN_FEE_TRON: آدرس‌های منتشرشدهٔ خود پروژه.
DLN_FEE_EVM=
DLN_FEE_SOLANA=
DLN_FEE_TRON=

# کارمزد مسیر cross-chain بر حسب bps و آدرس دریافتش.
# پیش‌فرض در کد: 30 و مقدار VITE_PAYOUT_EVM — server/xchain.js
CROSSCHAIN_FEE_BPS=
CROSSCHAIN_FEE_EVM=

# آدرس API اوستیوم و indexer دی‌واای‌دی‌ایکس.
# پیش‌فرض در کد: 'https://builder.prod.bedrock.ostium.io' — server/ostium.js
# پیش‌فرض در کد: 'https://indexer.dydx.trade' — server/dydx.js
OSTIUM_API_URL=
DYDX_INDEXER_URL=

# ── موتور فیوچرز v3 (/api/v1/futures/*) — server/futures/registry.js ──
# این متغیرها فقط می‌توانند دسترسی را «کم» کنند؛ هیچ مقداری یک پروتکل را
# AVAILABLE اعلام نمی‌کند. وضعیت همیشه از probe زنده (فید + ساب‌گراف) مشتق می‌شود.
# FUTURES_PROVIDERS_ENABLED      لیست با کاما؛ پیش‌فرض "ostium,dydx" — بقیه READ_ONLY/UNAVAILABLE
# FUTURES_PROVIDERS_MAINTENANCE  لیست با کاما؛ وضعیت MAINTENANCE (بدون سفارش)
# FUTURES_PROVIDERS_BLOCKED      لیست با کاما؛ وضعیت BLOCKED (صرافی‌های متمرکز همیشه مسدودند)
FUTURES_PROVIDERS_ENABLED=
FUTURES_PROVIDERS_MAINTENANCE=
FUTURES_PROVIDERS_BLOCKED=
# کارمزد FBT فیوچرز: bps از notional، سقف سخت ۱۰ bps و سقف خود پروتکل (Ostium: ۵۰).
# پیش‌فرض در کد: سیاست STANDARD = 5 bps؛ گیرنده = VITE_PAYOUT_EVM (یا آدرس منتشرشدهٔ پروژه).
# فرانت‌اند هرگز کارمزد را تعیین نمی‌کند — منبع حقیقت همین سرور است و در دفتر کارمزد ثبت می‌شود.
FUTURES_FBT_FEE_BPS=
FUTURES_FBT_FEE_RECIPIENT=

# ── ونیو (Velocity) در تب On-Chain (solana) ─────────────────────────────────
# پروتکل Drift متوقف (paused) شد و به‌صورت Velocity Protocol ادامه یافت: برنامهٔ
# زنجیره‌ای جدید (vELoC1audYbSYVRXn1vPaV8Axoa9oU6BYmNGZZBDZ1P)، هاست دادهٔ جدید و
# وثیقهٔ USDT به‌جای USDC. هاست‌های قدیمی data.api.drift.trade و dlob.drift.trade
# دیگر resolve نمی‌شوند؛ اگر این دو متغیر خالی بمانند همان هاست‌های رسمی Velocity
# استفاده می‌شوند.
# VELOCITY_DATA_API  منبع بازارها/قیمت/فاندینگ/OI: https://data.velocity.exchange
# VELOCITY_DLOB_API  منبع بهترین bid/ask:          https://dlob.velocity.exchange
VELOCITY_DATA_API=
VELOCITY_DLOB_API=

# مسیر «ثبت سفارش» ساخته شده است: bundle مرورگر از @drift-labs/sdk به
# @velocity-exchange/sdk مهاجرت کرد (scripts/vendor-velocity.mjs آن را در
# public/vendor/velocity-sdk.js می‌سازد) و src/lib/velocityTrade.js با آن
# initializeUserAccount، واریز USDT و placePerpOrder را می‌سازد؛ امضا و ارسال هر
# تراکنش با کیف پول سولانای خودِ کاربر است و FBT هیچ کلیدی نگه نمی‌دارد. اگر
# فید بمیرد registry همچنان UNAVAILABLE می‌دهد و هیچ سفارشی ساخته نمی‌شود.
# VITE_SOLANA_RPC  RPC سولانا برای خوانش‌ها/ارسال تراکنش در مرورگر؛ در build
#                  جایگزین می‌شود و حتماً باید روی Vercel ست شود و بعد از ست
#                  کردن redeploy لازم است (مقدار build-time است).
# SOLANA_RPC_URL   RPC سمت سرور (دریافت رسید در server/futures/adapters/drift.js).
#                  اگر خالی باشد سرور از VITE_SOLANA_RPC می‌خواند.
# VELOCITY_REFERRER (یا VITE_VELOCITY_REFERRER / نام قدیمی VITE_DRIFT_REFERRER)
#                  آدرس authority ریفرر FBT. فقط وقتی در تراکنشِ ساخت حساب
#                  استفاده می‌شود که همان آدرس روی زنجیره حساب userStats واقعی
#                  داشته باشد (fbtReferrerInfo آن را از RPC می‌خواند)؛ وگرنه
#                  تراکنشِ اولین بار بدون ریفرر ساخته می‌شود تا fail نشود.
#                  ساخت حساب‌های ریفرر (UserStats + User + RevenueShare):
#                    VELOCITY_KEYPAIR_PATH=/abs/path/fbt.json npm run velocity:referrer-setup
#                  جمع‌آوری کارمزد ریفرال (cron):
#                    VELOCITY_KEYPAIR_PATH=… VELOCITY_REFERRER=… npm run velocity:referral-sweep
#                  کی‌پیر هرگز داخل ریپو قرار نگیرد؛ فقط مسیر لوکال از env.
#                  نرخ رسمی: سطح Standard ۱۰٪ از کارمزد taker کاربرِ معرفی‌شده
#                  (کاربر ۵٪ تخفیف می‌گیرد)؛ Accelerated ۲۰٪ با تأیید تیم Velocity.
VITE_SOLANA_RPC=
VELOCITY_REFERRER=
VITE_VELOCITY_REFERRER=
VITE_DRIFT_REFERRER=

# ─────────────────────────────────────────────────────────────
# ۲.۹ — پروتکل Intent (امضا، حراج، لنگرگاه)
# ─────────────────────────────────────────────────────────────
# 🔒 همهٔ کلیدهای خصوصی این بخش فقط سمت سرور؛ هرگز با پیشوند VITE_.
# اگر خالی بمانند: همان نقش صادقانه «پیکربندی‌نشده» گزارش می‌شود و هیچ سند
# امضاشده‌ای تولید نمی‌شود — هیچ‌وقت امضای جعلی جای آن را نمی‌گیرد.

INTENT_SOLVER_PRIVATE_KEY=
INTENT_SOLVER_KEYS=
INTENT_SOLVER_ID=
INTENT_SOLVER_NAME=
INTENT_SOLVER_BONDS=

INTENT_VERIFIER_PRIVATE_KEY=
INTENT_VERIFIER_KEYS=
INTENT_VERIFIER_ID=
INTENT_VERIFIER_NAME=

INTENT_WATCHER_PRIVATE_KEY=
INTENT_WATCHER_KEYS=
INTENT_WATCHER_ID=
INTENT_WATCHER_NAME=

INTENT_OBSERVER_PRIVATE_KEY=
INTENT_COORDINATOR_PRIVATE_KEY=
INTENT_COORDINATOR_ROTATION_PRIVATE_KEY=
INTENT_COORDINATOR_ROTATIONS=
INTENT_COORDINATOR_KEY_ACTIVATED_AT=
INTENT_CROSS_CHAIN_PRIVATE_KEY=
INTENT_CROSS_CHAIN_VERIFIER_PRIVATE_KEY=
INTENT_CONFIDENTIAL_OPERATOR_KEYS=
INTENT_AUCTION_CLOSE_TOKEN=

# شناسهٔ هماهنگ‌کننده.
# پیش‌فرض در کد: 'fbt-coordinator' — server/intentAuctions.js
INTENT_COORDINATOR_ID=

# شبکه‌های لنگرگاه (JSON). ساختار در docs موجود است.
# پیش‌فرض در کد: '' — server/intentAnchors.js و server/intentRootAnchors.js
# اگر خالی بماند: لنگر انداختن روی زنجیره انجام نمی‌شود و وضعیت شواهد
# «پیکربندی‌نشده» گزارش می‌شود.
INTENT_ANCHOR_NETWORKS=
INTENT_MERKLE_ANCHOR_NETWORKS=
INTENT_CROSS_CHAIN_RPC_NETWORKS=

# آدرس قراردادها؛ بعد از اجرای scripts/deploy-all.mjs به دست می‌آیند.
INTENT_WORKFLOW_BATCH_ADDRESS=
INTENT_WORKFLOW_RPC_URL=
INTENT_MERKLE_ANCHOR_ADDRESS=
INTENT_ANCHOR_ADDRESS=
INTENT_ANCHOR_CHAIN_ID=
INTENT_ANCHOR_RPC_URL=
INTENT_ANCHOR_EXPLORER_BASE_URL=
INTENT_ANCHOR_MIN_CONFIRMATIONS=
INTENT_FEE_ROUTER_ADDRESS=

# سواپ اتمیک میان‌زنجیره‌ای (HTLC) — فاز 4d.
# ساختار: JSON مثل {"56":"0x...","1":"0x..."} یا جفت‌های «chainId:0x...» جدا با کاما.
# فقط وقتی قرارداد IntentAtomicSwap روی «حداقل دو زنجیره» مستقر شده باشد
# این متغیر را پر کنید؛ در غیر این صورت قابلیت، صادقانه «پیکربندی‌نشده»
# گزارش می‌شود و هرگز به حالت مرحله‌ای ساکت تنزل نمی‌کند.
# پیش‌فرض در کد: '' — server/intentAtomicSwap.js
INTENT_ATOMIC_SWAP_ADDRESSES=
# گزینه ساده برای استقرارهای هم‌آدرس روی چند زنجیره: مثلا address + "56,42161".
INTENT_ATOMIC_SWAP_ADDRESS=
INTENT_ATOMIC_SWAP_CHAIN_IDS=
# RPCهای اختصاصی راستی‌آزمایی پاهای سواپ اتمیک (سرور-تن).
# ساختار: [{"chainId":56,"rpcUrls":["https://…"]}] — https الزامی است؛
# http فقط برای زنجیرهٔ توسعهٔ محلی روی loopback پذیرفته می‌شود.
INTENT_ATOMIC_SWAP_RPC_NETWORKS=
# هدف‌های استقرار برای فعال‌ساز یک‌فرمانی scripts/activate-atomic-swap.mjs:
# [{"chainId":97,"rpcUrl":"https://…"},{"chainId":421614,"rpcUrl":"https://…"}]
# کلید DEPLOYER_PRIVATE_KEY فقط از env خوانده می‌شود و هرگز جایی نوشته نمی‌شود.
ATOMIC_SWAP_DEPLOY_TARGETS=

# فلش لیکوییدیتی (فلش لان) — فاز 152.
# آدرس قرارداد FlashLiquidityRouter per-chain. ساختار: جفت‌های «chainId:0x...» جدا با کاما.
# تا وقتی این خالی باشد، اسکن/برنامه‌ریزی فعال می‌ماند اما execution wallet-gated نمی‌شود.
# پیش‌فرض در کد: '' — server/flashLiquidityConfig.js
FLASH_LIQUIDITY_ROUTER_ADDRESSES=
# گزینه ساده برای یک زنجیره: اگر map بالا خالی باشد، این دو مقدار استفاده می‌شوند.
FLASH_LIQUIDITY_ROUTER_ADDRESS=
FLASH_LIQUIDITY_ROUTER_CHAIN_ID=
# فقط بعد از ممیزی مستقلِ واقعیِ قرارداد و انتشار گزارش آن true کنید.
# پیش‌فرض در کد: false — گیت ROUTER_CONTRACT_NOT_AUDITED تا آن موقع بسته می‌ماند.
FLASH_LIQUIDITY_ROUTER_AUDITED=
# RPC گیت شبیه‌سازی (مرحلهٔ ۷ خط لوله) — eth_call خشک روی وضعیت زندهٔ زنجیره.
# https الزامی است؛ http فقط روی loopback برای زنجیرهٔ محلی/فورک پذیرفته می‌شود.
# تا وقتی خالی باشد، capabilities صادقانه SIMULATION_UNAVAILABLE گزارش می‌کند.
FLASH_LIQUIDITY_SIMULATION_RPC=

# Secret Manager واقعی (KMS). تا وقتی تنظیم نشود، اپ صادقانه اعلام می‌کند که
# SecureMemoryMap فقط یک stand-in فاز ۲ است، نه یک Secret Manager واقعی.
INTENT_SECRET_MANAGER_PROVIDER=
INTENT_SECRET_MANAGER_KEY_REF=

# گواهی‌های بازبین مستقل، بعد از خرید audit.
# پیش‌فرض در کد: '' — server/intentOperators.js
INTENT_INDEPENDENT_OPERATOR_ATTESTATIONS=

# بازبین‌های مستقل مرحلهٔ ۳، جداشده با کاما. هر کدام id:base64spki (Ed25519).
# پیش‌فرض در کد: '' — server/intentStage3Probe.js
# اگر خالی بماند: independent-security-review هرگز صادر نمی‌شود. این فرآیند
# خودش آن kind را امضا نمی‌کند. بسته را از
# GET /api/intents/v1/stage3-review-package بگیرید و امضای Ed25519 روی
# بایت‌های digest را به POST /api/intents/v1/stage3-review بفرستید.
# فرمت: reviewerId:BASE64_SPKI  — مثال: acme-audit:MCowBQYDK2VwAyEA...
INTENT_INDEPENDENT_REVIEWERS=

# ─────────────────────────────────────────────────────────────
# ۲.۱۰ — دیپلوی قرارداد (فقط اجرای محلی)
# ─────────────────────────────────────────────────────────────
# ⚠️ هیچ‌کدام از این چهارتا هرگز نباید در Vercel قرار بگیرد. بخش ۴ را ببینید.

# 🔒 کلید خصوصی دیپلویر — فقط تست‌نت.
# پیش‌فرض در کد: '' — scripts/deploy-all.mjs
# اگر خالی بماند و DEPLOYER_KMS_KEY_ID هم نباشد: اسکریپت دیپلوی با پیام صریح
# متوقف می‌شود (خروج ۱). خود اپ اصلاً این متغیر را نمی‌خواند.
DEPLOYER_PRIVATE_KEY=

# شناسهٔ کلید AWS KMS — مسیر امن برای مین‌نت.
# پیش‌فرض در کد: '' — scripts/lib/kmsAdapter.mjs
DEPLOYER_KMS_KEY_ID=

# منطقهٔ AWS؛ فقط همراه DEPLOYER_KMS_KEY_ID معنی دارد.
# پیش‌فرض در کد: بدون مقدار — scripts/lib/kmsAdapter.mjs
# اگر خالی بماند: مسیر KMS نادیده گرفته می‌شود و به کلید خام برمی‌گردد.
AWS_REGION=

# RPC و شناسهٔ زنجیره برای دیپلوی.
# پیش‌فرض RPC_URL در کد: '' — scripts/deploy-all.mjs
# پیش‌فرض CHAIN_ID در کد: 0 (نامعتبر) — scripts/deploy-all.mjs
# اگر خالی بمانند: اسکریپت دیپلوی با پیام صریح متوقف می‌شود.
RPC_URL=
CHAIN_ID=

# انتخاب شبکه در scripts/deploy-feerouter.mjs.
# پیش‌فرض در کد: 'mainnet'
NETWORK=


# ═══════════════════════════════════════════════════════════════════════════
# ۳ — اختیاری با مقدار پیش‌فرض
# ═══════════════════════════════════════════════════════════════════════════
# همهٔ اینها پیش‌فرض کارآمدی در کد دارند. خالی گذاشتنشان هیچ قابلیتی را
# خاموش نمی‌کند؛ فقط همان پیش‌فرض به کار می‌رود.

# ─────────────────────────────────────────────────────────────
# ۳.۱ — آدرس‌های اپ
# ─────────────────────────────────────────────────────────────

# آدرس پایهٔ API که مرورگر صدا می‌زند.
# پیش‌فرض در کد: '/api' — src/lib/api.js
# نکته: بیلد اندروید صفحات را از https://localhost بارگذاری می‌کند، پس آنجا
# '/api' به سروری نمی‌رسد و باید آدرس کامل بدهید.
VITE_API_BASE=

# آدرس عمومی سایت، برای متامسک و لینک‌های اشتراک‌گذاری.
# پیش‌فرض در کد: '' در src/lib/nativeShell.js و 'https://fbtswap.ir' در
# scripts/gen-landing.mjs
VITE_PUBLIC_URL=

# ایمیل پشتیبانی در فوتر و دکمهٔ تماس.
# پیش‌فرض در کد: 'fbtswap@gmail.com' — src/lib/contact.js
VITE_SUPPORT_EMAIL=

# VITE_WALLETCONNECT_PROJECT_ID — عمداً به‌صورت خط فعال اینجا نیست.
# مقدار واقعی ثابتِ WC_PROJECT_ID داخل src/context/WalletContext.jsx است و
# override با متغیر محیطی بازنشسته شده (تست walletconnect-wiring.mjs همین را
# تضمین می‌کند). شناسهٔ پروژهٔ WalletConnect عمومی است و رمز نیست.
# تنها جایی که سرور آن را می‌خواند server/intentAutoEvidence.js است، فقط برای
# ثبت «شاهد wallet-provider»؛ نبودنش فقط همان یک شاهد را حذف می‌کند.

# مقصد پروکسی dev سرور ویت.
# پیش‌فرض در کد: 'http://localhost:8787' — vite.config.js
API_TARGET=

# پورت و هاست سرور Node.
# پیش‌فرض در کد: 8787 و '0.0.0.0' — server/index.js
PORT=
HOST=

# فهرست origin های مجاز CORS، جداشده با کاما.
# پیش‌فرض در کد: بدون مقدار = همه مجازند — server/app.js
CORS_ORIGIN=

# نام نسخه در صفحهٔ فروشگاه.
# پیش‌فرض در کد: '1.0' — server/shop.js
APP_VERSION_NAME=

# ─────────────────────────────────────────────────────────────
# ۳.۲ — کارمزد و آدرس‌های دریافت
# ─────────────────────────────────────────────────────────────

# کارمزد رابط بر حسب bps.
# پیش‌فرض در کد: 70 (۰٫۷٪)، سقف سخت 100 — src/lib/feeBps.js
# مقدار خارج از بازه نادیده گرفته می‌شود و با هشدار به ۷۰ برمی‌گردد؛ سقف ۱٪
# قابل دور زدن نیست.
VITE_FEE_BPS=

# همان عدد برای سمت سرور.
# پیش‌فرض در کد: مقدار VITE_FEE_BPS، وگرنه 70 — server/solana.js
FEE_BPS=

# کارمزد builder روی صرافی‌های مشتقه بر حسب bps.
# پیش‌فرض در کد: 5، سقف 10 — src/lib/builderCodes.js
VITE_BUILDER_BPS=

# آدرس واحد دریافت همهٔ درآمد EVM. اگر ست شود بر همهٔ آدرس‌های per-chain غالب است.
# پیش‌فرض در کد: مقدار VITE_PAYOUT_EVM — src/lib/chains.js
VITE_FEE_RECIPIENT=
FEE_RECIPIENT=

# آدرس قرارداد FeeRouter در مرورگر.
# پیش‌فرض در کد: null — src/lib/chains.js
