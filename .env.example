# =============================================================================
# NEXUS — server configuration
#
# Copy to `.env` and fill in. NEVER commit the real `.env`, and never put any
# of these values in `VITE_*` variables: anything prefixed with VITE_ is baked
# into the JS bundle and is fully public.
# =============================================================================

PORT=8787

# --- Telegram -----------------------------------------------------------------
# From @BotFather. Treat like a password — it can send messages as your bot.
TELEGRAM_BOT_TOKEN=

# The public HTTPS URL of the built app, registered with @BotFather via /newapp.
# During development this is your tunnel URL (ngrok / cloudflared).
WEBAPP_URL=

# --- Market data --------------------------------------------------------------
# CoinGecko. Leave blank to use the free public tier (heavily rate limited).
COINGECKO_API_KEY=
# `demo` for a Demo-plan key, `pro` for a paid key (switches to pro-api host).
COINGECKO_PLAN=demo

# --- WalletConnect (client-side, PUBLIC by design) --------------------------
# A WalletConnect project ID is *meant* to be public — it identifies your app
# in the relay, it is not a secret. Get one free at https://cloud.reown.com
# This is the ONLY VITE_ variable that may hold an identifier.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Platform fee (0.5%) ------------------------------------------------------
#
# DEFAULT BEHAVIOUR: no setup required. Swaps route through the KyberSwap
# aggregator, whose audited router sends 0.5% straight to VITE_FEE_RECIPIENT
# inside the same transaction. Nothing to deploy, no gas to spend.
#
# Where the fee lands. Defaults to the FBT wallet baked into src/lib/chains.js.
VITE_FEE_RECIPIENT=0xaf5CE154cEfd22Da5BD1D0a54479E81963A224d6
# Mode is derived automatically: 'contract' when VITE_FEE_ROUTER_ADDRESS is
# set, otherwise 'aggregator'. The fee is always charged — there is no
# zero-fee mode, by design.

# --- Per-network payout addresses --------------------------------------------
#
# The fee for a swap is paid on the SAME network the swap happened on, so each
# address family needs its own receiving address. If a chain has no address
# configured, the resolver falls back to the next valid address in the SAME
# family — it never crosses families, because an EVM address on Tron is a burn,
# not a payment.
#
# Defaults are FBT's published addresses (src/lib/payout.js). These are public
# receiving addresses; there are no keys here and there must never be.
VITE_PAYOUT_EVM=0xaf5CE154cEfd22Da5BD1D0a54479E81963A224d6
VITE_PAYOUT_SOLANA=B6gysn5JGQQnJmyzjj6ZJiNECjDYYyJ5LrXvr61BFLv4
VITE_PAYOUT_TRON=TJNNUB2zStAvm1wHci5vf9gBGFzbBKjBJZ
#
# Optional per-chain overrides. Leave blank to use VITE_PAYOUT_EVM everywhere
# (correct by default — the same key controls that address on every EVM chain).
VITE_PAYOUT_ETHEREUM=
VITE_PAYOUT_BSC=
VITE_PAYOUT_POLYGON=
VITE_PAYOUT_ARBITRUM=
VITE_PAYOUT_BASE=
VITE_PAYOUT_OPTIMISM=
VITE_PAYOUT_AVALANCHE=

# --- Web push (optional) ------------------------------------------------------
#
# Without a VAPID key the app schedules notifications LOCALLY on the device and
# says so in Settings. That is a real, working feature — it is just not
# server-sent push, and the UI must not claim otherwise.
#
# To enable real push, generate a keypair:
#   npx web-push generate-vapid-keys
# The public key is compiled into the bundle and is meant to be public. The
# private key stays server-side and is what actually authorises a send.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Address of your deployed FeeRouter contract (contracts/FeeRouter.sol).
#
# NOTE: this is the CONTRACT address, not your wallet. The revenue wallet
# (0xaf5CE154cEfd22Da5BD1D0a54479E81963A224d6) is a constructor argument and
# lives inside the deployed contract.
# Deploy it with:
#   node scripts/compile.mjs
#   DEPLOYER_PRIVATE_KEY=0x... FEE_RECIPIENT=0xYourWallet \
#     node scripts/deploy-feerouter.mjs
#
# LEAVE BLANK to use the KyberSwap aggregator, which collects the fee for you
# with no contract to deploy. Set it only if you prefer your own router.
VITE_FEE_ROUTER_ADDRESS=

# NOTE: DEPLOYER_PRIVATE_KEY is passed inline to the deploy script and must
# never be written into this file or committed.

# --- Firebase (web config — public by design) ---------------------------------
# These identify your project in client requests; Firebase expects them to ship
# in your JS bundle. Access is controlled by Firestore Security Rules, NOT by
# hiding these values. See the rules snippet in src/lib/firebase.js.
#
# NEVER put a Firebase *service account* private key anywhere near this app.
# That key grants full admin access to the entire project and belongs only on a
# server, in a secrets manager.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fbt-cryp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fbt-cryp
VITE_FIREBASE_STORAGE_BUCKET=fbt-cryp.appspot.com
VITE_FIREBASE_SENDER_ID=878518573520
VITE_FIREBASE_APP_ID=

# --- Ops ----------------------------------------------------------------------
# Requests per minute per user/IP against /api.
RATE_LIMIT=120
UPSTREAM_TIMEOUT_MS=12000
# Comma-separated allowed origins; omit to allow all (fine behind a tunnel).
CORS_ORIGIN=

# =============================================================================
# INTENTIONALLY ABSENT: exchange trading keys.
#
# Kraken / Nobitex / CoinRithm keys let code move real money. They are not read
# anywhere in this repo, and they should not be added to a Telegram mini app
# that end users touch. If you build real order routing:
#   • keep keys in a secrets manager, never in .env on the app server;
#   • run order placement in a separate service the web tier cannot reach;
#   • restrict the key to trade-only, no withdrawal, with an IP allowlist;
#   • add KYC/AML, per-user limits and an audit log before a single real order.
# Any key you have already pasted into a chat, issue or commit must be revoked
# and regenerated — assume it is compromised.
# =============================================================================

# --- AI analysis (SERVER-SIDE ONLY — these are billable keys) ------------------
# Never expose these as VITE_* variables. Anything VITE_-prefixed is compiled
# into the JS bundle and readable by every user; scrapers harvest such keys
# within hours and you would be paying for their inference.
OPENROUTER_API_KEY=
JINA_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_CACHE_TTL_MS=21600000

# --- Deployment note -----------------------------------------------------------
# The Android APK serves its pages from https://localhost, so a relative '/api'
# path has no host to resolve against and the AI features silently do nothing.
# Deploy the API (see docs/DEPLOY-API-FA.md) and set VITE_API_BASE at BUILD time
# to the absolute origin, e.g. https://your-app.vercel.app/api

# --- Vercel Blob (optional but recommended in production) ---------------------
# Vercel serverless functions are stateless: every cold start begins with an
# empty in-memory cache. Without persistence the "one AI call per coin per day"
# guarantee degrades to "one call per cold start", so on a busy day you'd pay
# OpenRouter per user instead of per day.
#
# With this token set, AI responses are also written to Blob storage and
# survive cold starts. Market data stays memory-only — it's free to refetch and
# changes every 30s, so persisting it would add latency for no benefit.
#
# Omit it and everything still works, just with a memory-only cache.
BLOB_READ_WRITE_TOKEN=

# --- Gemini (preferred AI provider) -------------------------------------------
# Google AI Studio key. Gemini Flash has a generous free quota, which matters
# because AI cost scales with users while swap-fee revenue scales with volume —
# the two aren't correlated. Falls back to OpenRouter automatically on error.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Gemini in-app fallback (ONLY if you have no backend) ---------------------
# If set, the packaged app calls Gemini directly and the key ships inside the
# APK where it CAN be extracted. Google's mitigation for this exact case is an
# Android application restriction: bind the key to package ir.fbt.swap plus
# your signing SHA-1 in Google Cloud Console, and set a quota cap.
# Prefer GEMINI_API_KEY (server-side) whenever a backend is deployed.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash

# --- Store-safe build ---------------------------------------------------------
# Iranian stores (Bazaar, Myket) restrict gambling-styled content. Set this to
# build a variant with the arcade removed entirely — routes and nav tiles both,
# so a reviewer cannot reach them. See docs/PUBLISH-IRAN-FA.md
VITE_DISABLE_GAMES=false
