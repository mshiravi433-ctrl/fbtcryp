# ═══════════════════════════════════════════════════════════════
# FBT INTENT AI — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# این فایل را کپی کنید به .env و مقادیر واقعی را پر کنید
# cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# موج ۰ — Configuration (الزامی برای فعال‌سازی)
# ─────────────────────────────────────────────────────────────

# Vercel Blob Storage Token
# از: Vercel Dashboard → Storage → Blob → Create Token
# فرمت: vercel_blob_rw_...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN_HERE

# Ecosystem Certifiers (telegramUserId:Label)
# از: @userinfobot در تلگرام userId خود را بگیرید
# فرمت: 123456789:Your Name
# چند certifier: 111:Reviewer1,222:Reviewer2
ECOSYSTEM_CERTIFIERS=YOUR_TELEGRAM_ID:YOUR_LABEL

# ─────────────────────────────────────────────────────────────
# موج ۱ — Chain Infrastructure (الزامی برای deploy)
# ─────────────────────────────────────────────────────────────

# Deployer Wallet (فقط testnet — هرگز mainnet با raw key)
# ⚠️ این کلید هرگز در Vercel یا git قرار نگیرد
# فقط برای اجرای محلی: node scripts/deploy-all.mjs
DEPLOYER_PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY_HERE

# RPC Endpoints
# از: Alchemy یا QuickNode
# Arbitrum Sepolia: https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
# Arbitrum One: https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL=https://YOUR_RPC_ENDPOINT_HERE
CHAIN_ID=421614

# ─────────────────────────────────────────────────────────────
# موج ۱ — Contract Addresses (بعد از deploy-all تنظیم می‌شوند)
# ─────────────────────────────────────────────────────────────

# اینها بعد از اجرای deploy-all.mjs به دست می‌آیند
INTENT_WORKFLOW_BATCH_ADDRESS=0x...
INTENT_MERKLE_ANCHOR_ADDRESS=0x...
INTENT_ANCHOR_ADDRESS=0x...
INTENT_FEE_ROUTER_ADDRESS=0x...

# Network configurations (JSON format)
INTENT_MERKLE_ANCHOR_NETWORKS=[{"chainId":421614,"name":"Arbitrum Sepolia","contract":"0x...","rpcUrl":"https://...","minConfirmations":2}]
INTENT_ANCHOR_NETWORKS=[{"chainId":421614,"name":"Arbitrum Sepolia","contract":"0x...","rpcUrl":"https://...","explorerBaseUrl":"https://sepolia.arbiscan.io","minConfirmations":12}]

# ─────────────────────────────────────────────────────────────
# موج ۳ — Third-Party (الزامی برای شواهد CA/Sandbox/Review)
# ─────────────────────────────────────────────────────────────

# Secret Manager (اختیاری — نیاز به KMS واقعی)
# INTENT_SECRET_MANAGER_PROVIDER=aws-kms
# INTENT_SECRET_MANAGER_KEY_REF=arn:aws:kms:...

# Independent Review (بعد از خرید audit)
# INTENT_INDEPENDENT_OPERATOR_ATTESTATIONS=reviewer-id-1:signed-attestation

# ─────────────────────────────────────────────────────────────
# ⚠️ هرگز اینها را set نکنید (مگر با Provider واقعی)
# ─────────────────────────────────────────────────────────────

# ❌ هرگز raw private key در Vercel env قرار ندهید
# ❌ هرگز seed phrase یا mnemonic در Vercel env قرار ندهید
# ❌ هرگز API key با دسترسی withdrawal در Vercel env قرار ندهید

# ─────────────────────────────────────────────────────────────
# Development فقط (تست محلی — هرگز production)
# ─────────────────────────────────────────────────────────────

# Telegram Bot (development only)
# TELEGRAM_BOT_TOKEN=0000000000:test-token

# Rate Limits (development defaults)
# RATE_LIMIT=100000
# LEARNING_EVENT_RATE_LIMIT=100
# INTENT_SETTLEMENT_RATE_LIMIT=100
# ECOSYSTEM_WRITE_RATE_LIMIT=25

# ═══════════════════════════════════════════════════════════════
# دستورالعمل سریع:
# ═══════════════════════════════════════════════════════════════
# 1. cp .env.example .env
# 2. .env را با مقادیر واقعی پر کنید
# 3. node scripts/validate-activation-env.mjs (تأیید موج ۰)
# 4. DEPLOYER_PRIVATE_KEY=... RPC_URL=... CHAIN_ID=421614 node scripts/deploy-all.mjs
# 5. Environment variables خروجی را در Vercel set کنید
# 6. تزریق شواهد: POST /api/intents/v1/operator-evidence
# 7. Unfreeze: POST /api/intents/v1/unfreeze
# ═══════════════════════════════════════════════════════════════
