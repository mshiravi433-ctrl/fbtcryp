# =============================================================================
# NEXUS — server configuration
#
# Copy to `.env` and fill in. NEVER commit the real `.env`, and never put any
# of these values in `VITE_*` variables: anything prefixed with VITE_ is baked
# into the JS bundle and is fully public.
# =============================================================================

PORT=8787

# --- Telegram -----------------------------------------------------------------
# From @BotFather. Treat like a password — it can send messages as your bot.
TELEGRAM_BOT_TOKEN=

# The public HTTPS URL of the built app, registered with @BotFather via /newapp.
# During development this is your tunnel URL (ngrok / cloudflared).
WEBAPP_URL=

# --- Market data --------------------------------------------------------------
# CoinGecko. Leave blank to use the free public tier (heavily rate limited).
COINGECKO_API_KEY=
# `demo` for a Demo-plan key, `pro` for a paid key (switches to pro-api host).
COINGECKO_PLAN=demo

# --- WalletConnect (client-side, PUBLIC by design) --------------------------
# A WalletConnect project ID is *meant* to be public — it identifies your app
# in the relay, it is not a secret. Get one free at https://cloud.reown.com
# This is the ONLY VITE_ variable that may hold an identifier.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Nobitex (PUBLIC market data only) ---------------------------------------
# The server proxies only unauthenticated IRT price endpoints, for caching and
# to work around CORS. User API tokens are NEVER handled here: each user's
# token is encrypted in their own browser and sent straight to Nobitex.
# Do not add a NOBITEX_API_KEY here — centralizing user keys makes you a
# custodian of their exchange accounts.
NOBITEX_BASE=https://api.nobitex.ir

# --- Ops ----------------------------------------------------------------------
# Requests per minute per user/IP against /api.
RATE_LIMIT=120
UPSTREAM_TIMEOUT_MS=12000
# Comma-separated allowed origins; omit to allow all (fine behind a tunnel).
CORS_ORIGIN=

# =============================================================================
# INTENTIONALLY ABSENT: exchange trading keys.
#
# Kraken / Nobitex / CoinRithm keys let code move real money. They are not read
# anywhere in this repo, and they should not be added to a Telegram mini app
# that end users touch. If you build real order routing:
#   • keep keys in a secrets manager, never in .env on the app server;
#   • run order placement in a separate service the web tier cannot reach;
#   • restrict the key to trade-only, no withdrawal, with an IP allowlist;
#   • add KYC/AML, per-user limits and an audit log before a single real order.
# Any key you have already pasted into a chat, issue or commit must be revoked
# and regenerated — assume it is compromised.
# =============================================================================
