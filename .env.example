# ═══════════════════════════════════════════════════════════════════════════
# ۴ — هرگز در Vercel نگذارید
# ═══════════════════════════════════════════════════════════════════════════
#
# اینها فقط روی دستگاه خودتان و فقط هنگام اجرای اسکریپت معنی دارند. گذاشتنشان
# در متغیرهای محیطی Vercel یعنی سپردن کنترل دارایی به یک پنل وب.
#
#   ❌ DEPLOYER_PRIVATE_KEY
#      کلید خصوصی امضای دیپلوی. فقط تست‌نت، فقط محلی. برای مین‌نت از
#      DEPLOYER_KMS_KEY_ID + AWS_REGION استفاده کنید تا کلید هرگز از KMS
#      بیرون نیاید. خود اپ این متغیر را اصلاً نمی‌خواند.
#
#   ❌ هر عبارت بازیابی (seed / mnemonic)
#      هیچ‌جای این کد seed نمی‌خواند. اگر جایی خواسته شد، آن کد مال ما نیست.
#
#   ❌ هر کلید API با دسترسی برداشت (withdrawal)
#      کلید صرافی با مجوز برداشت هرگز در سرور این اپ لازم نیست.
#
#   ❌ هر رمزی با پیشوند VITE_
#      پیشوند VITE_ یعنی «داخل جاوااسکریپت کاربر کامپایل شود». VITE_ روی یک
#      رمز، آن رمز را منتشر می‌کند نه ذخیره.
#
#   ⚠️ VITE_GEMINI_API_KEY یک استثنای آگاهانه است: داخل APK قابل استخراج است.
#      فقط با «Android API key restriction» گوگل فعالش کنید، یا خالی بگذارید
#      تا اپ از مسیر امن سرور استفاده کند.
#
# نکتهٔ WalletConnect: مقدار WC_PROJECT_ID داخل src/context/WalletContext.jsx
# ثابت است و متغیر محیطی ندارد. شناسهٔ پروژهٔ WalletConnect عمومی است.
#
# ═══════════════════════════════════════════════════════════════════════════
# دستورالعمل سریع
# ═══════════════════════════════════════════════════════════════════════════
# ۱. cp .env.example .env
# ۲. .env را با مقادیر واقعی پر کنید (این فایل را دست‌نخورده در گیت بگذارید)
# ۳. node scripts/validate-activation-env.mjs   ← بخش ۱ را تأیید می‌کند
# ۴. متغیرهای بخش‌های ۱ تا ۳ را در Vercel وارد کنید، بخش ۴ را هرگز
# ۵. Redeploy — Vercel متغیرها را در زمان build می‌خواند
# ۶. بررسی: GET /api/cron/status و GET /api/intents/v1/evidence-status
#
# راهنمای گام‌به‌گام با اسکرین‌شات و توضیح فارسی: docs/ENV-FA.md
# ═══════════════════════════════════════════════════════════════════════════

# ── خرید USDT با تومان، فقط برای ایرانیان (غیرفعال و fail-closed) ───────────
# IMPORTANT: this is NOT a browser-side Wallex key flow. WALLEX_API_KEY is
# server-only; never prefix it with VITE_, put it in a request header from the
# browser, or store a customer's exchange key on a device.
#
# Setting IRAN_BUY_ENABLED=true alone never exposes the tab. server/iranBuyConfig
# also requires atomic Upstash idempotency, one explicitly approved EVM USDT
# network/contract, a reviewed customer-payment collector, a signed payment
# receipt contract, and a documented Wallex withdrawal-reconciliation contract.
# The current repository deliberately has no approved merchant-payment adapter,
# so keep this false until the deployment review described in
# docs/IRAN-BUY-WALLEX-READINESS.md is complete.
IRAN_BUY_ENABLED=false
WALLEX_API_BASE_URL=https://api.wallex.ir
WALLEX_API_KEY=
# Reserved, unused: do not invent an API-secret signature scheme. The reviewed
# OTC reference documents X-API-Key only; use this only if current Wallex docs
# later define a reviewed server-side secret contract.
WALLEX_API_SECRET=
# Reserved only for a future Wallex-documented webhook. The current feature
# does not treat this value as proof that Wallex supports a customer callback.
WALLEX_WEBHOOK_SECRET=
IRAN_BUY_USDT_NETWORK=
IRAN_BUY_USDT_NETWORK_LABEL=
IRAN_BUY_NETWORK_APPROVED=false
IRAN_BUY_WALLET_FAMILY=EVM
IRAN_BUY_EVM_CHAIN_ID=
IRAN_BUY_USDT_TOKEN_CONTRACT=
IRAN_BUY_USDT_DECIMALS=
IRAN_BUY_MIN_TOMAN=
IRAN_BUY_MAX_TOMAN=
IRAN_BUY_MIN_CONFIRMATIONS=3
# Per verified Telegram user/minute; write actions and status polling have
# separate durable Upstash counters so normal status refreshes cannot consume
# the order-creation budget.
IRAN_BUY_ORDER_RATE_LIMIT=10
IRAN_BUY_STATUS_RATE_LIMIT=20
# Future reviewed payment-adapter contract — these do not bypass the permanent
# no-adapter / OTC-cost-cap blockers in code. Do not configure a guessed URL or
# webhook schema as a substitute for a signed provider agreement.
IRAN_BUY_PAYMENT_ADAPTER=
IRAN_BUY_PAYMENT_CALLBACK_URL=
IRAN_BUY_PAYMENT_WEBHOOK_SECRET=
IRAN_BUY_PAYMENT_CONTRACT_VERIFIED=false
IRAN_BUY_APPROVED_PAYMENT_HOSTS=
IRAN_BUY_WALLEX_WITHDRAWAL_LIFECYCLE_VERIFIED=false
IRAN_BUY_SETTLEMENT_RECONCILIATION_APPROVED=false

# ── Financial Goals (Financial OS) ───────────────────────────────────────
# Optional. Salts the hash the API derives from a browser's per-install device
# scope before it becomes a storage key. A goal set is scoped to the verified
# Telegram session when there is one, and to this hashed device scope when
# there is not — it is scope, NOT authentication, and it never stores the raw
# label. Leave it empty and the deployment falls back to CRON_SECRET, then to a
# fixed default (fine for a preview; set it for production).
FINANCIAL_GOALS_SALT=

# ── Smart Money (FBT On-Chain Intelligence Layer) ───────────────────────
# Every smart-money metric degrades honestly when its source is unavailable —
# no key is required for the page to work, but keys unlock denser/complete data.
#
# Keyless sources used by default: public chain RPC, DexScreener (pairs,
# liquidity, volume, early tokens), Blockscout (address history, balances,
# holders), CoinGecko prices. Set an explorer key for denser EVM wallet
# history/P&L and Solscan for labelled Solana flows.
#   ETHERSCAN_API_KEY / BSCSCAN_API_KEY / POLYGONSCAN_API_KEY /
#   ARBISCAN_API_KEY / BASESCAN_API_KEY / OPTIMISTIC_ETHERSCAN_API_KEY
#   SOLSCAN_API_KEY     → labelled Solana whale transfers/holders
#   SOLANA_RPC_URL      → override the public Solana RPC (keyless default OK)
# Tunable thresholds (sensible defaults in server/smartMoney/config.js):
#   SM_WHALE_USD=250000           minimum value counted as a whale transfer
#   SM_BIG_TRADE_USD=100000       floor for top buyers/sellers
#   SM_WHALE_PORTFOLIO_USD=5000000 portfolio floor for the whale board
#   SM_LP_EVENT_USD=200000        minimum reported liquidity event
#   SM_ACCUMULATION_THRESHOLD=70  confidence (0-100) to flag accumulation
#   SM_DISTRIBUTION_THRESHOLD=70  confidence (0-100) to flag distribution
#   SM_EARLY_MAX_AGE_HRS=72       max age for an "early" token
#   SM_ALERT_COOLDOWN_MS=21600000 per-wallet alert cooldown (6h)
# CRON_SECRET guards /api/cron/smart-money (the alert evaluation cycle);
# alerts are delivered through the existing web-push / FCM transport.
SOLANA_RPC_URL=
SM_WHALE_USD=
SM_BIG_TRADE_USD=
SM_ACCUMULATION_THRESHOLD=
SM_DISTRIBUTION_THRESHOLD=
