# Signing material — never commit these
*.keystore
*.jks
keystore.properties
release.keystore

# test harness build output
test/.out/
scripts/locales/ar-todo.txt

# collected operational evidence (real digests + measurements, re-earned per run)
evidence.json

# farm fork-probe evidence records. A protocol whose --strict fork probe passed is
# committed as a canonical, auditable anchor (farm-fork-evidence/<id>.json, with the
# probe log sha256) so the fail-closed staged gate is reproducible in a fresh CI/Vercel
# checkout. Transient per-run records for OTHER protocols are re-earned and not tracked;
# only the committed one is material. scripts/record-farm-fork-evidence.mjs rewrites them.
farm-fork-evidence/*.json
!farm-fork-evidence/aave-base.json
!farm-fork-evidence/aave-arbitrum.json
!farm-fork-evidence/compound-base.json
!farm-fork-evidence/lido.json
!farm-fork-evidence/morpho-base.json
*-probe-detail.json
.sandbox/

# esbuild-prebundled Velocity SDK (regenerated by scripts/vendor-velocity.mjs)
public/vendor/
scripts/.vendor-velocity-entry.generated.mjs
.shots/

scripts/.vendor-kamino-entry.generated.mjs
# the browser-Buffer shim esbuild emits into the vendor bundle
scripts/.vendor-kamino-buffer-shim.generated.mjs

# Intent OS sandbox registry (local dev only, rebuilt every boot)
data/

# FBT Radio media (large binaries)
FBT_Radio_*.mp3
fbt_radio_part*.mp3
parts/*.mp3

# Python (forecast worker) — bytecode never ships.
__pycache__/
*.py[cod]

# Kronos ONNX model artifacts — build output of scripts/kronos-export-onnx.py.
# ~33 MB of weights: produced in CI / by the operator, never committed.
# They are published instead: the `kronos-model` orphan branch holds exactly
# these four graphs + the manifest, and GitHub Pages serves that branch at
# <Pages origin>/fbtcryp/ (VITE_KRONOS_MODEL_BASE_URL). The app history stays
# at ~1 MB; a clone never pays for weights it may not need.
public/kronos-local/
public/kronos-onnx/

# ONNX Runtime Web engines. The worker imports ORT as a module, so Vite copies
# the .wasm engine into /assets with a content hash and rewrites the URL. These
# two folders are what you get if someone hand-copies them instead — a second
# 12–25 MB copy of the same binary, with no cache-busting. Never tracked.
public/ort/
public/onnxruntime/

# Local scratch space (probes, one-off scripts) — never shipped.
.scratch/
